@model FlowDesk.Application.Features.Performance.PerformanceMetricsDto

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-lightning-charge text-warning me-2"></i> Redis & Performance Optimization</h3>
        <p class="text-muted mb-0">Distributed caching metrics, database query indexing, memory telemetry, and live benchmark suite.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-action="Clear" class="d-inline">
            <input type="hidden" name="clearAll" value="true" />
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to flush all cached entries?');">
                <i class="bi bi-trash3 me-1"></i> Flush All Cache
            </button>
        </form>
    </div>
</div>

@if (TempData["Benchmark"] != null)
{
    <div class="alert alert-info alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-speedometer me-2"></i> <strong>Benchmark Results:</strong> @TempData["Benchmark"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Telemetry & Status Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">CACHE ENGINE</div>
                    <div class="fw-bold text-success fs-6 text-truncate mt-1" style="max-width: 150px;">
                        <i class="bi bi-hdd-network me-1"></i> @Model.CacheStats.EngineStatus
                    </div>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-3">
                    <i class="bi bi-cpu fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">CACHE HIT RATE</div>
                    <div class="fs-3 fw-bold text-primary">@Model.CacheStats.HitRatePercentage.ToString("F1")%</div>
                    <small class="text-muted">@Model.CacheStats.HitCount hits / @Model.CacheStats.MissCount misses</small>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-3">
                    <i class="bi bi-bullseye fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">ACTIVE CACHED KEYS</div>
                    <div class="fs-3 fw-bold text-warning">@Model.CacheStats.TotalKeys</div>
                    <small class="text-muted">@Model.CacheStats.InvalidationCount evicted</small>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-3">
                    <i class="bi bi-key fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom h-100 p-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">PROCESS WORKING SET</div>
                    <div class="fs-3 fw-bold text-info">@Model.EstimatedMemoryUsageMb.ToString("F1") MB</div>
                    <small class="text-muted">@Model.DatabaseProvider</small>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-3">
                    <i class="bi bi-memory fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Live Benchmark Suite -->
    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span><i class="bi bi-speedometer2 me-2"></i> Latency Benchmark Suite</span>
                <span class="badge bg-primary">Live Profiler</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Runs comparative execution tests comparing direct SQL Server database query execution time vs Redis/Distributed Cache retrieval speed.
                </p>
                <form method="post" asp-action="Benchmark">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Sample Query Iterations</label>
                        <select name="iterations" class="form-select">
                            <option value="25">25 Iteration Sample Test</option>
                            <option value="50" selected>50 Iteration Standard Test</option>
                            <option value="100">100 Iteration Stress Test</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-play-fill me-1"></i> Execute Benchmark Suite
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Manual Cache Eviction -->
    <div class="col-lg-6">
        <div class="card card-custom h-100">
            <div class="card-header bg-light">
                <i class="bi bi-funnel me-2"></i> Cache Invalidation Controls
            </div>
            <div class="card-body">
                <p class="text-muted small">
                    Invalidate specific cache entries or purge key patterns when workflow definitions, permissions, or system metadata change.
                </p>
                <form method="post" asp-action="Clear" class="mb-3">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="text" name="prefix" class="form-control" placeholder="Prefix pattern (e.g. Workflow_, User_)..." />
                        <button type="submit" class="btn btn-outline-warning">
                            <i class="bi bi-eraser me-1"></i> Evict by Prefix
                        </button>
                    </div>
                </form>
                <form method="post" asp-action="Clear">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="text" name="key" class="form-control" placeholder="Exact Cache Key (e.g. RequestTypes_All)..." />
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Remove Key
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Database Indexes & Health Status -->
<div class="card card-custom mt-4">
    <div class="card-header bg-light">
        <i class="bi bi-database-gear me-2"></i> Configured Database Indexes & Query Optimizations
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Target Entity</th>
                        <th>Indexed Columns</th>
                        <th>Optimization Objective</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Requests</td>
                        <td><span class="font-monospace small">Status, RequesterUserId</span></td>
                        <td>Optimizes Employee Dashboard & "My Requests" filter queries</td>
                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active Index</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Requests</td>
                        <td><span class="font-monospace small">DepartmentId, CreatedAtUtc</span></td>
                        <td>Accelerates Manager & Admin department aggregation reports</td>
                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active Index</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">ApprovalInstances</td>
                        <td><span class="font-monospace small">ApproverUserId, Status</span></td>
                        <td>Optimizes Manager Pending Approvals Inbox lookups</td>
                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active Index</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">Workflows</td>
                        <td><span class="font-monospace small">RequestTypeId, IsPublished, IsActive</span></td>
                        <td>Fast resolution of active workflow definitions during submission</td>
                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active Index</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold">AuditLogs</td>
                        <td><span class="font-monospace small">EntityName, EntityId</span></td>
                        <td>Accelerates entity history timeline queries</td>
                        <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Active Index</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
