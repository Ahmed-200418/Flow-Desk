@model FlowDesk.Application.Features.Reports.AdminDashboardReportDto
@using FlowDesk.Application.Features.Reports
@{
    var employeeReport = ViewData["EmployeeReport"] as EmployeeDashboardReportDto;
    var managerReport = ViewData["ManagerReport"] as ManagerDashboardReportDto;
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-pie-chart text-emerald-600"></i> Executive Reporting & Analytics
        </h1>
        <p class="text-sm text-slate-500 mt-1">System-wide performance indicators, SLA compliance, department throughput, and bottleneck diagnostics.</p>
    </div>
    <div class="flex gap-2">
        <a asp-action="Export"
           asp-route-fromDate="@ViewData["FromDate"]"
           asp-route-toDate="@ViewData["ToDate"]"
           asp-route-departmentId="@ViewData["DepartmentId"]"
           class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl hover:bg-emerald-100 transition-colors shadow-sm">
            <i class="bi bi-file-earmark-spreadsheet"></i> Export Analytics CSV
        </a>
    </div>
</div>

<!-- Executive Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">TOTAL REQUESTS</span>
                <div class="text-2xl font-bold text-slate-900 mt-1">@Model.TotalRequests.ToString("N0")</div>
                <span class="text-xs text-slate-400">All-time platform volume</span>
            </div>
            <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                <i class="bi bi-file-earmark-bar-graph text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">PENDING APPROVALS</span>
                <div class="text-2xl font-bold text-amber-600 mt-1">@Model.PendingRequests.ToString("N0")</div>
                <span class="text-xs text-slate-400">Active in approval pipelines</span>
            </div>
            <div class="p-3 bg-amber-50 text-amber-600 rounded-xl">
                <i class="bi bi-hourglass-split text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">AVG APPROVAL TIME</span>
                <div class="text-2xl font-bold text-sky-700 mt-1">@Model.AverageApprovalTimeHours.ToString("F1")h</div>
                <span class="text-xs text-slate-400">Submission to completion</span>
            </div>
            <div class="p-3 bg-sky-50 text-sky-600 rounded-xl">
                <i class="bi bi-stopwatch text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">SLA COMPLIANCE</span>
                <div class="text-2xl font-bold text-emerald-600 mt-1">@Model.SlaCompliancePercentage.ToString("F1")%</div>
                <span class="text-xs text-slate-400">Completed within SLA limits</span>
            </div>
            <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                <i class="bi bi-shield-check text-xl"></i>
            </div>
        </div>
    </div>
</div>

<!-- Personal Quick Overview Widgets -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    @if (employeeReport != null)
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between font-semibold text-slate-800">
                <span class="flex items-center gap-2"><i class="bi bi-person-workspace text-emerald-600"></i> Employee Dashboard (My Requests)</span>
                <a asp-controller="Requests" asp-action="Index" class="text-xs text-emerald-700 hover:text-emerald-800 font-semibold">View All &rarr;</a>
            </div>
            <div class="p-5 flex-1">
                <div class="grid grid-cols-4 gap-2 text-center">
                    <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl">
                        <div class="text-lg font-bold text-slate-900">@employeeReport.TotalMyRequests</div>
                        <span class="text-[11px] text-slate-500 font-medium">Total</span>
                    </div>
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl">
                        <div class="text-lg font-bold text-amber-700">@employeeReport.PendingCount</div>
                        <span class="text-[11px] text-amber-700 font-medium">Pending</span>
                    </div>
                    <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl">
                        <div class="text-lg font-bold text-emerald-700">@employeeReport.ApprovedCount</div>
                        <span class="text-[11px] text-emerald-700 font-medium">Approved</span>
                    </div>
                    <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl">
                        <div class="text-lg font-bold text-rose-700">@employeeReport.RejectedCount</div>
                        <span class="text-[11px] text-rose-700 font-medium">Rejected</span>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (managerReport != null)
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden flex flex-col">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between font-semibold text-slate-800">
                <span class="flex items-center gap-2"><i class="bi bi-briefcase text-emerald-600"></i> Manager Dashboard (Pending Approvals)</span>
                <a asp-controller="Approvals" asp-action="Inbox" class="text-xs text-emerald-700 hover:text-emerald-800 font-semibold">Approval Inbox &rarr;</a>
            </div>
            <div class="p-5 flex-1">
                <div class="grid grid-cols-4 gap-2 text-center">
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl">
                        <div class="text-lg font-bold text-amber-700">@managerReport.PendingApprovalsCount</div>
                        <span class="text-[11px] text-amber-700 font-medium">Assigned</span>
                    </div>
                    <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl">
                        <div class="text-lg font-bold text-emerald-700">@managerReport.ApprovedTodayCount</div>
                        <span class="text-[11px] text-emerald-700 font-medium">Approved Today</span>
                    </div>
                    <div class="p-3 bg-rose-50 border border-rose-200 rounded-xl">
                        <div class="text-lg font-bold text-rose-700">@managerReport.RejectedTodayCount</div>
                        <span class="text-[11px] text-rose-700 font-medium">Rejected Today</span>
                    </div>
                    <div class="p-3 bg-rose-700 text-white rounded-xl shadow-sm">
                        <div class="text-lg font-bold">@managerReport.OverdueApprovalsCount</div>
                        <span class="text-[11px] text-rose-100 font-medium">Overdue SLA</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Department Performance Analytics -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 font-semibold text-slate-800 flex items-center gap-2">
        <i class="bi bi-building text-emerald-600"></i> Department Performance & Throughput
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    <th class="px-5 py-3">Department</th>
                    <th class="px-5 py-3">Total Volume</th>
                    <th class="px-5 py-3">Approved</th>
                    <th class="px-5 py-3">Rejected</th>
                    <th class="px-5 py-3">Avg Processing Time</th>
                    <th class="px-5 py-3">Approval Ratio</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
                @foreach (var dept in Model.DepartmentAnalytics)
                {
                    var ratio = dept.TotalRequests > 0 ? Math.Round((double)dept.ApprovedRequests / dept.TotalRequests * 100.0, 1) : 0.0;
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-5 py-3 font-bold text-slate-900 flex items-center gap-2">
                            <i class="bi bi-diagram-3 text-emerald-600"></i>@dept.DepartmentName
                        </td>
                        <td class="px-5 py-3 font-semibold text-slate-700">@dept.TotalRequests</td>
                        <td class="px-5 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800">
                                @dept.ApprovedRequests
                            </span>
                        </td>
                        <td class="px-5 py-3">
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800">
                                @dept.RejectedRequests
                            </span>
                        </td>
                        <td class="px-5 py-3 font-mono text-slate-700">@dept.AverageApprovalTimeHours.ToString("F1") hrs</td>
                        <td class="px-5 py-3 w-48">
                            <div class="flex items-center gap-2">
                                <div class="w-full bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200">
                                    <div class="bg-emerald-500 h-2 rounded-full" style="width: @ratio%"></div>
                                </div>
                                <span class="font-bold text-slate-800 text-[11px]">@ratio%</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Workflow Bottleneck Diagnostics -->
<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <span class="font-semibold text-slate-800 flex items-center gap-2"><i class="bi bi-exclamation-triangle text-amber-500"></i> Workflow Bottleneck Diagnostics</span>
        <span class="text-xs text-slate-500">Steps with longest average waiting times</span>
    </div>
    @if (!Model.WorkflowBottlenecks.Any())
    {
        <div class="text-center py-8 text-slate-500">
            <i class="bi bi-check-circle-fill text-3xl text-emerald-600"></i>
            <p class="mt-2 text-xs font-medium">No approval bottlenecks detected across active workflows.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="px-5 py-3">Step Name</th>
                        <th class="px-5 py-3">Workflow Context</th>
                        <th class="px-5 py-3">Pending In Step</th>
                        <th class="px-5 py-3">Avg Waiting Time</th>
                        <th class="px-5 py-3">Severity</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    @foreach (var b in Model.WorkflowBottlenecks)
                    {
                        var severityBadge = b.AverageWaitTimeHours > 48 ? "bg-rose-100 text-rose-800 border-rose-200" : (b.AverageWaitTimeHours > 24 ? "bg-amber-100 text-amber-800 border-amber-200" : "bg-sky-100 text-sky-800 border-sky-200");
                        var severityText = b.AverageWaitTimeHours > 48 ? "High Bottleneck (>48h)" : (b.AverageWaitTimeHours > 24 ? "Medium Delay (>24h)" : "Normal Progress");
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-5 py-3 font-bold text-slate-900">@b.StepName</td>
                            <td class="px-5 py-3 text-slate-600">@b.WorkflowName</td>
                            <td class="px-5 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">@b.TotalPendingInStep requests</span></td>
                            <td class="px-5 py-3 font-mono font-semibold text-slate-900">@b.AverageWaitTimeHours.ToString("F1") hours</td>
                            <td class="px-5 py-3"><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold border @severityBadge">@severityText</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

