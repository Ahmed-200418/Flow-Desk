@{
    ViewData["Title"] = "Create Request Type";
    var orgs = ViewBag.Organizations as List<FlowDesk.Application.Features.Organizations.OrganizationDto> ?? new List<FlowDesk.Application.Features.Organizations.OrganizationDto>();
}

<div class="max-w-2xl mx-auto w-full min-w-0 animate-slide-up">
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <i class="bi bi-tag-fill text-emerald-600"></i> Create Request Type
            </h1>
            <p class="text-sm text-slate-500 mt-1">Configure a new enterprise business request category.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-all shadow-xs">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Organization <span class="text-rose-500">*</span></label>
                <select name="organizationId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" required>
                    @foreach (var o in orgs)
                    {
                        <option value="@o.Id">@o.Name (@o.Code)</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Request Type Name <span class="text-rose-500">*</span></label>
                <input type="text" name="name" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" placeholder="e.g. Purchase Request" required />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Request Type Code <span class="text-rose-500">*</span></label>
                <input type="text" name="code" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white font-mono uppercase transition-all" placeholder="e.g. PURCHASE" required />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description <span class="text-rose-500">*</span></label>
                <textarea name="description" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all resize-y" placeholder="Describe the purpose of this request type..." required></textarea>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Icon Name (Bootstrap Icons)</label>
                <input type="text" name="icon" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white font-mono transition-all" placeholder="e.g. cart3, file-earmark-text, tag" />
                <p class="text-[11px] text-slate-400 mt-1">Bootstrap icon name without 'bi-' prefix.</p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-all">Cancel</a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
                    <i class="bi bi-check-lg"></i> Save Request Type
                </button>
            </div>
        </form>
    </div>
</div>
