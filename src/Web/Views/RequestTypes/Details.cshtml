@model FlowDesk.Application.Features.RequestTypes.RequestTypeDto
@{
    ViewData["Title"] = "Request Type Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold text-dark m-0"><i class="bi bi-@(Model.Icon ?? "tag") text-primary me-2"></i>@Model.Name</h4>
        <span class="badge bg-light text-dark border fw-bold">Code: @Model.Code</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card card-custom">
            <div class="card-header fw-bold">Request Type Configuration</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8 fw-semibold text-dark">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Code</dt>
                    <dd class="col-sm-8"><span class="badge bg-dark">@Model.Code</span></dd>

                    <dt class="col-sm-4 text-muted">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4 text-muted">Icon</dt>
                    <dd class="col-sm-8"><i class="bi bi-@(Model.Icon ?? "tag") me-2"></i>@(Model.Icon ?? "tag")</dd>

                    <dt class="col-sm-4 text-muted">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-status bg-approved">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-status bg-draft">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Created Date</dt>
                    <dd class="col-sm-8">@Model.CreatedAtUtc.ToString("F")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
