@model FlowDesk.Application.Features.Organizations.OrganizationDto
@{
    ViewData["Title"] = "Organization Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold text-dark m-0">@Model.Name</h4>
        <span class="badge bg-light text-dark border fw-bold">@Model.Code</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card card-custom mb-4">
            <div class="card-header fw-bold">General Information</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Organization Name</dt>
                    <dd class="col-sm-9 fw-semibold text-dark">@Model.Name</dd>

                    <dt class="col-sm-3 text-muted">Code</dt>
                    <dd class="col-sm-9"><span class="badge bg-dark">@Model.Code</span></dd>

                    <dt class="col-sm-3 text-muted">Description</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd>

                    <dt class="col-sm-3 text-muted">Status</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-status bg-approved">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-status bg-draft">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Created Date</dt>
                    <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("F")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom">
            <div class="card-header fw-bold">Quick Links</div>
            <div class="card-body">
                <a asp-controller="Departments" asp-action="Index" asp-route-organizationId="@Model.Id" class="btn btn-outline-primary w-100 mb-2">
                    <i class="bi bi-diagram-3 me-2"></i> View Departments
                </a>
            </div>
        </div>
    </div>
</div>
