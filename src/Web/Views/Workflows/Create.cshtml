@{
    ViewData["Title"] = "Create Workflow Definition";
    var orgId = (Guid)(ViewBag.OrganizationId ?? Guid.Empty);
    var requestTypes = ViewBag.RequestTypes as List<FlowDesk.Application.Features.RequestTypes.RequestTypeDto> ?? new List<FlowDesk.Application.Features.RequestTypes.RequestTypeDto>();
}

<div class="max-w-2xl mx-auto animate-slide-up">
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <i class="bi bi-diagram-3-fill text-emerald-600"></i> Create Workflow Definition
            </h1>
            <p class="text-sm text-slate-500 mt-1">Configure a new automated multi-step routing workflow.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-all shadow-xs">
            <i class="bi bi-arrow-left"></i> Back to Workflows
        </a>
    </div>

    <!-- Main Form Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="organizationId" value="@orgId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Triggering Request Type <span class="text-rose-500">*</span></label>
                <select name="requestTypeId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" required>
                    <option value="">-- Select Request Type --</option>
                    @foreach (var rt in requestTypes)
                    {
                        <option value="@rt.Id">@rt.Name (@rt.Code)</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Workflow Name <span class="text-rose-500">*</span></label>
                <input type="text" name="name" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" placeholder="e.g. High Value Purchase Approval Workflow" required />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Workflow Code <span class="text-rose-500">*</span></label>
                <input type="text" name="code" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white font-mono transition-all" placeholder="e.g. WF_PURCHASE_HIGH" required />
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Description <span class="text-rose-500">*</span></label>
                <textarea name="description" rows="4" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all resize-y" placeholder="Describe the workflow routing purpose and approval hierarchy..." required></textarea>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-all">Cancel</a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
                    <i class="bi bi-check-lg"></i> Save & Open Builder
                </button>
            </div>
        </form>
    </div>
</div>
