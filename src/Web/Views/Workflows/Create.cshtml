@{
    ViewData["Title"] = "Create Workflow Definition";
    var orgId = (Guid)(ViewBag.OrganizationId ?? Guid.Empty);
    var requestTypes = ViewBag.RequestTypes as List<FlowDesk.Application.Features.RequestTypes.RequestTypeDto> ?? new List<FlowDesk.Application.Features.RequestTypes.RequestTypeDto>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-2 text-primary"></i> Create Workflow Definition
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="organizationId" value="@orgId" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2 small">
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Triggering Request Type</label>
                        <select name="requestTypeId" class="form-select" required>
                            <option value="">-- Select Request Type --</option>
                            @foreach (var rt in requestTypes)
                            {
                                <option value="@rt.Id">@rt.Name (@rt.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Workflow Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. High Value Purchase Approval Workflow" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Workflow Code</label>
                        <input type="text" name="code" class="form-control" placeholder="e.g. WF_PURCHASE_HIGH" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Describe the workflow routing purpose..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save & Open Builder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
