@model FlowDesk.Application.Features.Workflows.WorkflowDto
@{
    ViewData["Title"] = $"Workflow Builder - {Model.Name}";
    var selectedVersion = ViewBag.SelectedVersion as FlowDesk.Application.Features.Workflows.WorkflowVersionDto;
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-sliders text-emerald-600"></i> @Model.Name 
            <span class="px-2.5 py-0.5 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-mono text-xs">@Model.Code</span>
        </h1>
        <p class="text-sm text-slate-500 mt-1">@Model.Description</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-all shadow-xs">
            <i class="bi bi-arrow-left"></i> Back to Workflows
        </a>
        
        <form asp-action="CreateVersion" method="post" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="workflowId" value="@Model.Id" />
            <button type="submit" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-xl transition-all">
                <i class="bi bi-plus-circle"></i> New Draft Version
            </button>
        </form>

        @if (selectedVersion != null && selectedVersion.Status == WorkflowVersionStatus.Draft)
        {
            <form asp-action="PublishVersion" method="post" class="inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="workflowId" value="@Model.Id" />
                <input type="hidden" name="versionId" value="@selectedVersion.Id" />
                <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
                    <i class="bi bi-rocket-takeoff"></i> Publish Version @selectedVersion.VersionNumber
                </button>
            </form>
        }
    </div>
</div>

<!-- Versions Selection Bar -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 mb-6">
    <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
            <i class="bi bi-diagram-2 text-emerald-600"></i> Available Versions:
        </span>
        @foreach (var ver in Model.Versions)
        {
            var isActiveVersion = selectedVersion != null && selectedVersion.Id == ver.Id;
            <a asp-action="Builder" asp-route-id="@Model.Id" asp-route-versionId="@ver.Id"
               class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all @(isActiveVersion ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")">
                v@(ver.VersionNumber)
                @if (ver.Status == WorkflowVersionStatus.Published)
                {
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">Published</span>
                }
                else if (ver.Status == WorkflowVersionStatus.Draft)
                {
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">Draft</span>
                }
            </a>
        }
    </div>
</div>

@if (selectedVersion != null)
{
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mb-6">
        <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="bi bi-diagram-2 text-emerald-600"></i>
                <span class="font-bold text-slate-900">Steps for Version @selectedVersion.VersionNumber</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-@(selectedVersion.Status == WorkflowVersionStatus.Published ? "emerald-100 text-emerald-800 border border-emerald-200" : "amber-100 text-amber-800 border border-amber-200")">@selectedVersion.Status</span>
            </div>

            @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
            {
                <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-all hover:-translate-y-0.5" data-bs-toggle="modal" data-bs-target="#addStepModal">
                    <i class="bi bi-plus-lg"></i> Add Step
                </button>
            }
        </div>
        <div class="p-6">
            @if (selectedVersion.Steps.Any())
            {
                <div class="space-y-4">
                    @foreach (var step in selectedVersion.Steps)
                    {
                        <div class="border border-slate-200 rounded-xl p-5 bg-white shadow-xs hover:shadow-md transition-shadow">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3 pb-3 border-b border-slate-100">
                                <div class="flex items-center gap-3 flex-wrap">
                                    <span class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 font-bold text-xs">Step @step.StepNumber</span>
                                    <h3 class="text-base font-bold text-slate-900">@step.StepName</h3>
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">Type: @step.ApproverType</span>
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-sky-50 text-sky-700 border border-sky-200"><i class="bi bi-clock me-1"></i>SLA: @step.TimeoutHours hrs</span>
                                </div>

                                @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
                                {
                                    <div class="flex items-center gap-2">
                                        <button type="button" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg transition-colors" data-bs-toggle="modal" data-bs-target="#addConditionModal_@step.Id">
                                            <i class="bi bi-funnel text-emerald-600"></i> Add Rule Condition
                                        </button>
                                        <form asp-action="DeleteStep" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workflowId" value="@Model.Id" />
                                            <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                            <input type="hidden" name="stepId" value="@step.Id" />
                                            <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Step"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <!-- Rule Conditions List -->
                            <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block mb-2"><i class="bi bi-filter-square me-1"></i> Step Routing Conditions & Rules</span>
                                @if (step.Conditions.Any())
                                {
                                    <div class="space-y-2">
                                        @foreach (var cond in step.Conditions)
                                        {
                                            <div class="flex items-center justify-between text-xs bg-white p-2.5 rounded-lg border border-slate-200">
                                                <div class="flex items-center gap-2">
                                                    <span class="px-2 py-0.5 rounded bg-slate-800 text-white font-mono text-[10px] font-bold">@cond.LogicGroup</span>
                                                    <span class="font-mono text-emerald-700 font-semibold">@cond.FieldName</span> 
                                                    <span class="font-bold text-slate-600">@cond.Operator</span> 
                                                    <span class="font-mono bg-slate-100 px-2 py-0.5 rounded border border-slate-200 font-semibold text-slate-800">"@cond.Value"</span>
                                                </div>
                                                @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
                                                {
                                                    <form asp-action="RemoveCondition" method="post" class="inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="workflowId" value="@Model.Id" />
                                                        <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                                        <input type="hidden" name="conditionId" value="@cond.Id" />
                                                        <button type="submit" class="text-slate-400 hover:text-rose-600 p-1 transition-colors"><i class="bi bi-x-lg"></i></button>
                                                    </form>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-500 italic">No special conditions (always applies to all requests).</span>
                                }
                            </div>
                        </div>

                        <!-- Add Condition Modal per step -->
                        <div class="modal fade" id="addConditionModal_@step.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-2xl border-0 shadow-xl overflow-hidden">
                                    <form asp-action="AddCondition" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workflowId" value="@Model.Id" />
                                        <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                        <input type="hidden" name="workflowStepId" value="@step.Id" />
                                        <div class="modal-header bg-slate-50 border-b border-slate-200 px-6 py-4">
                                            <h5 class="modal-title text-base font-bold text-slate-900">Add Rule Condition for @step.StepName</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-6 space-y-4">
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Target Field Name</label>
                                                <input type="text" name="fieldName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900" placeholder="TotalAmount, Priority, Department, etc." required />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Operator</label>
                                                <select name="operatorType" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900">
                                                    <option value="Equals">Equals (==)</option>
                                                    <option value="NotEquals">Not Equals (!=)</option>
                                                    <option value="GreaterThan">GreaterThan (&gt;)</option>
                                                    <option value="GreaterThanOrEqual">GreaterThanOrEqual (&gt;=)</option>
                                                    <option value="LessThan">LessThan (&lt;)</option>
                                                    <option value="LessThanOrEqual">LessThanOrEqual (&lt;=)</option>
                                                    <option value="Contains">Contains</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Expected Value</label>
                                                <input type="text" name="value" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900" placeholder="e.g. 5000, High, IT, etc." required />
                                            </div>
                                            <div>
                                                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Logic Group</label>
                                                <select name="logicGroup" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900">
                                                    <option value="AND">AND</option>
                                                    <option value="OR">OR</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="modal-footer bg-slate-50 border-t border-slate-200 px-6 py-3.5 flex justify-end gap-3">
                                            <button type="button" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 rounded-xl" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-all">Save Condition</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 inline-flex items-center justify-center text-2xl mb-3 border border-emerald-100">
                        <i class="bi bi-diagram-2"></i>
                    </div>
                    <h3 class="text-base font-bold text-slate-900 mb-1">No approval steps added yet</h3>
                    <p class="text-xs text-slate-500 mb-4">Add at least one approval step to publish this workflow version.</p>
                </div>
            }
        </div>
    </div>

    <!-- Add Step Modal -->
    <div class="modal fade" id="addStepModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-2xl border-0 shadow-xl overflow-hidden">
                <form asp-action="AddStep" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workflowId" value="@Model.Id" />
                    <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                    <div class="modal-header bg-slate-50 border-b border-slate-200 px-6 py-4">
                        <h5 class="modal-title text-base font-bold text-slate-900">Add Workflow Step</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-6 space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Step Name</label>
                            <input type="text" name="stepName" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900" placeholder="e.g. Manager Approval" required />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Approver Resolution Type</label>
                            <select name="approverType" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900">
                                <option value="DepartmentManager">Department Manager</option>
                                <option value="Role">Role Based</option>
                                <option value="Position">Position Based</option>
                                <option value="SpecificUser">Specific User</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">SLA Timeout (Hours)</label>
                            <input type="number" name="timeoutHours" value="48" min="1" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900" required />
                        </div>
                    </div>
                    <div class="modal-footer bg-slate-50 border-t border-slate-200 px-6 py-3.5 flex justify-end gap-3">
                        <button type="button" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-800 rounded-xl" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="px-5 py-2 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-all">Add Step</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
