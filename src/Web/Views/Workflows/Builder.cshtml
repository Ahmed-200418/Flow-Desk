@model FlowDesk.Application.Features.Workflows.WorkflowDto
@{
    ViewData["Title"] = $"Workflow Builder - {Model.Name}";
    var selectedVersion = ViewBag.SelectedVersion as FlowDesk.Application.Features.Workflows.WorkflowVersionDto;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0"><i class="bi bi-sliders text-primary me-2"></i> @Model.Name <span class="badge bg-dark">@Model.Code</span></h4>
        <small class="text-muted">@Model.Description</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i> Back</a>
        
        <form asp-action="CreateVersion" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="workflowId" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-plus-circle me-1"></i> Create New Version</button>
        </form>

        @if (selectedVersion != null && selectedVersion.Status == WorkflowVersionStatus.Draft)
        {
            <form asp-action="PublishVersion" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="workflowId" value="@Model.Id" />
                <input type="hidden" name="versionId" value="@selectedVersion.Id" />
                <button type="submit" class="btn btn-success fw-semibold"><i class="bi bi-rocket-takeoff me-1"></i> Publish Version @selectedVersion.VersionNumber</button>
            </form>
        }
    </div>
</div>

<!-- Versions Selection Bar -->
<div class="card card-custom mb-4">
    <div class="card-body p-3 d-flex align-items-center gap-2">
        <span class="fw-bold text-secondary me-2">Versions:</span>
        @foreach (var ver in Model.Versions)
        {
            var isActiveVersion = selectedVersion != null && selectedVersion.Id == ver.Id;
            <a asp-action="Builder" asp-route-id="@Model.Id" asp-route-versionId="@ver.Id"
               class="btn btn-sm @(isActiveVersion ? "btn-primary" : "btn-light border")">
                v@ver.VersionNumber
                @if (ver.Status == WorkflowVersionStatus.Published)
                {
                    <span class="badge bg-success ms-1">Published</span>
                }
                else if (ver.Status == WorkflowVersionStatus.Draft)
                {
                    <span class="badge bg-warning text-dark ms-1">Draft</span>
                }
            </a>
        }
    </div>
</div>

@if (selectedVersion != null)
{
    <div class="card card-custom mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-diagram-2 text-primary me-2"></i> Steps for Version @selectedVersion.VersionNumber
                <span class="badge bg-@(selectedVersion.Status == WorkflowVersionStatus.Published ? "success" : "warning text-dark") me-2">@selectedVersion.Status</span>
            </span>

            @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
            {
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addStepModal">
                    <i class="bi bi-plus-lg me-1"></i> Add Step
                </button>
            }
        </div>
        <div class="card-body">
            @if (selectedVersion.Steps.Any())
            {
                <div class="vstack gap-3">
                    @foreach (var step in selectedVersion.Steps)
                    {
                        <div class="border rounded p-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary fs-6">Step @step.StepNumber</span>
                                    <h6 class="fw-bold m-0 text-dark">@step.StepName</h6>
                                    <span class="badge bg-secondary">Type: @step.ApproverType</span>
                                    <span class="badge bg-info text-white">SLA: @step.TimeoutHours hrs</span>
                                </div>

                                @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
                                {
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addConditionModal_@step.Id">
                                            <i class="bi bi-funnel me-1"></i> Add Rule Condition
                                        </button>
                                        <form asp-action="DeleteStep" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="workflowId" value="@Model.Id" />
                                            <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                            <input type="hidden" name="stepId" value="@step.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                }
                            </div>

                            <!-- Rule Conditions List -->
                            <div class="mt-3 bg-light p-2 rounded">
                                <small class="fw-bold text-muted d-block mb-1"><i class="bi bi-filter-square me-1"></i> STEP CONDITIONS & ROUTING RULES</small>
                                @if (step.Conditions.Any())
                                {
                                    <ul class="list-group list-group-flush small">
                                        @foreach (var cond in step.Conditions)
                                        {
                                            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center py-1">
                                                <span>
                                                    <span class="badge bg-dark me-1">@cond.LogicGroup</span>
                                                    <code>@cond.FieldName</code> <strong>@cond.Operator</strong> "<code>@cond.Value</code>"
                                                </span>
                                                @if (selectedVersion.Status == WorkflowVersionStatus.Draft)
                                                {
                                                    <form asp-action="RemoveCondition" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="workflowId" value="@Model.Id" />
                                                        <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                                        <input type="hidden" name="conditionId" value="@cond.Id" />
                                                        <button type="submit" class="btn btn-sm text-danger p-0 border-0"><i class="bi bi-x-lg"></i></button>
                                                    </form>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted small">No special conditions (always applies).</span>
                                }
                            </div>
                        </div>

                        <!-- Add Condition Modal per step -->
                        <div class="modal fade" id="addConditionModal_@step.Id" tabindex="-1">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form asp-action="AddCondition" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workflowId" value="@Model.Id" />
                                        <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                                        <input type="hidden" name="workflowStepId" value="@step.Id" />
                                        <div class="modal-header">
                                            <h5 class="modal-title fw-bold">Add Rule Condition for @step.StepName</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Target Field Name</label>
                                                <input type="text" name="fieldName" class="form-control" placeholder="TotalAmount, Priority, Department, etc." required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Operator</label>
                                                <select name="operatorType" class="form-select">
                                                    <option value="Equals">Equals (==)</option>
                                                    <option value="NotEquals">Not Equals (!=)</option>
                                                    <option value="GreaterThan">GreaterThan (&gt;)</option>
                                                    <option value="GreaterThanOrEqual">GreaterThanOrEqual (&gt;=)</option>
                                                    <option value="LessThan">LessThan (&lt;)</option>
                                                    <option value="LessThanOrEqual">LessThanOrEqual (&lt;=)</option>
                                                    <option value="Contains">Contains</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Expected Value</label>
                                                <input type="text" name="value" class="form-control" placeholder="e.g. 5000, High, IT, etc." required />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold">Logic Group</label>
                                                <select name="logicGroup" class="form-select">
                                                    <option value="AND">AND</option>
                                                    <option value="OR">OR</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Save Condition</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-diagram-2 fs-1 text-secondary"></i>
                    <h6 class="fw-bold mt-2">No approval steps added yet</h6>
                    <p class="small">Add at least one approval step to publish this workflow version.</p>
                </div>
            }
        </div>
    </div>

    <!-- Add Step Modal -->
    <div class="modal fade" id="addStepModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="AddStep" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="workflowId" value="@Model.Id" />
                    <input type="hidden" name="workflowVersionId" value="@selectedVersion.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">Add Workflow Step</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Step Name</label>
                            <input type="text" name="stepName" class="form-control" placeholder="e.g. Manager Approval" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Approver Resolution Type</label>
                            <select name="approverType" class="form-select">
                                <option value="DepartmentManager">Department Manager</option>
                                <option value="Role">Role Based</option>
                                <option value="Position">Position Based</option>
                                <option value="SpecificUser">Specific User</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">SLA Timeout (Hours)</label>
                            <input type="number" name="timeoutHours" value="48" min="1" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add Step</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
