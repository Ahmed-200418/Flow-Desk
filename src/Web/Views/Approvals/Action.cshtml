@model FlowDesk.Application.Features.Requests.RequestDetailDto
@{
    ViewData["Title"] = $"Review Request #{Model.RequestNumber}";
    var approvalItem = (FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto)ViewBag.ApprovalItem;
    var idempotencyKey = (string)ViewBag.IdempotencyKey;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0">Review Request #@Model.RequestNumber</h4>
        <small class="text-muted">Assigned Step @approvalItem.StepNumber &bull; Requester: @Model.RequesterName</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Inbox" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i> Back to Inbox</a>
        <button type="button" class="btn btn-success fw-semibold" data-bs-toggle="modal" data-bs-target="#approveModal"><i class="bi bi-check-lg me-1"></i> Approve</button>
        <button type="button" class="btn btn-warning fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#returnModal"><i class="bi bi-arrow-return-left me-1"></i> Return</button>
        <button type="button" class="btn btn-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="bi bi-x-lg me-1"></i> Reject</button>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card card-custom mb-4">
            <div class="card-header fw-bold">
                <i class="bi bi-file-earmark-text text-primary me-2"></i> Request Overview
            </div>
            <div class="card-body">
                <h5 class="fw-bold text-dark mb-2">@Model.Title</h5>
                <p class="text-secondary bg-light p-3 rounded" style="white-space: pre-line;">@Model.Description</p>

                <div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-primary">Total Amount:</span>
                    <span class="fs-4 fw-bold text-primary">@Model.TotalAmount.ToString("N2") @Model.Currency</span>
                </div>
            </div>
        </div>

        <!-- Line Items -->
        <div class="card card-custom mb-4">
            <div class="card-header fw-bold">
                <i class="bi bi-list-ul text-primary me-2"></i> Request Items
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Item Name</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.ItemName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("N2") @Model.Currency</td>
                                    <td class="fw-bold">@item.TotalPrice.ToString("N2") @Model.Currency</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card card-custom mb-4">
            <div class="card-header fw-bold">
                <i class="bi bi-clock-history text-primary me-2"></i> Approval Task Summary
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted d-block">Current Step Number:</small>
                    <span class="fw-bold fs-5 text-primary">Step @approvalItem.StepNumber</span>
                </div>
                <div class="mb-3">
                    <small class="text-muted d-block">Assigned Date:</small>
                    <span class="fw-semibold">@approvalItem.AssignedAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
                <div>
                    <small class="text-muted d-block">SLA Due Date:</small>
                    <span class="badge bg-warning text-dark">@approvalItem.DueAtUtc.ToString("yyyy-MM-dd HH:mm")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.Id" />
                <input type="hidden" name="approvalInstanceId" value="@approvalItem.ApprovalInstanceId" />
                <input type="hidden" name="idempotencyKey" value="@idempotencyKey" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-success"><i class="bi bi-check-circle me-1"></i> Approve Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Confirm approval for request #@Model.RequestNumber.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Approval Comment (Optional)</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Add optional approval note..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-semibold"><i class="bi bi-check-lg me-1"></i> Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Return Modal -->
<div class="modal fade" id="returnModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Return" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.Id" />
                <input type="hidden" name="approvalInstanceId" value="@approvalItem.ApprovalInstanceId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning"><i class="bi bi-arrow-return-left me-1"></i> Return Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Return this request to the requester for clarification or editing.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Return Reason / Feedback</label>
                        <textarea name="comment" class="form-control" rows="3" required placeholder="Explain what changes are needed..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-semibold">Confirm Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.Id" />
                <input type="hidden" name="approvalInstanceId" value="@approvalItem.ApprovalInstanceId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-1"></i> Reject Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Reject this request. This action is final.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rejection Reason</label>
                        <textarea name="comment" class="form-control" rows="3" required placeholder="Provide reason for rejection..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-semibold">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>
