@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto>
@using FlowDesk.Domain.Enums
@{
    ViewData["Title"] = "Pending Approvals Inbox";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-inbox text-emerald-600"></i> Pending Approvals Inbox
        </h1>
        <p class="text-sm text-slate-500 mt-1">Requests assigned to you, your role, or delegated to you awaiting decision.</p>
    </div>
    <div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
            <i class="bi bi-clock-history"></i> @Model.TotalCount Pending
        </span>
    </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    <th class="px-5 py-3.5">Request #</th>
                    <th class="px-5 py-3.5">Title</th>
                    <th class="px-5 py-3.5">Type</th>
                    <th class="px-5 py-3.5">Requester</th>
                    <th class="px-5 py-3.5">Priority</th>
                    <th class="px-5 py-3.5">Total Amount</th>
                    <th class="px-5 py-3.5">Step</th>
                    <th class="px-5 py-3.5">SLA Status</th>
                    <th class="px-5 py-3.5">Context</th>
                    <th class="px-5 py-3.5 text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-5 py-4 font-bold text-emerald-700">@item.RequestNumber</td>
                            <td class="px-5 py-4 font-semibold text-slate-900">@item.RequestTitle</td>
                            <td class="px-5 py-4 text-slate-600">@item.RequestTypeName</td>
                            <td class="px-5 py-4 text-slate-600">@item.RequesterName</td>
                            <td class="px-5 py-4">
                                @if (item.Priority == RequestPriority.Urgent || item.Priority == RequestPriority.High)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800 border border-rose-200"><i class="bi bi-exclamation-triangle"></i>@item.Priority</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">@item.Priority</span>
                                }
                            </td>
                            <td class="px-5 py-4 font-bold text-slate-900">@item.TotalAmount.ToString("N2") <span class="text-[11px] text-slate-400">@item.Currency</span></td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">Step @item.StepNumber</span>
                            </td>
                            <td class="px-5 py-4">
                                @if (item.SlaStatus == "Escalated")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-700 text-white"><i class="bi bi-graph-up-arrow"></i> Escalated</span>
                                }
                                else if (item.SlaStatus == "Overdue")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800 border border-rose-200"><i class="bi bi-exclamation-triangle"></i> Overdue</span>
                                }
                                else if (item.SlaStatus == "Reminder")
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-200"><i class="bi bi-bell"></i> Reminder</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200"><i class="bi bi-shield-check"></i> On Time</span>
                                }
                            </td>
                            <td class="px-5 py-4">
                                @if (item.IsDelegated)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-lg text-[10px] font-medium bg-sky-50 text-sky-700 border border-sky-200" title="Delegated from @item.DelegatedFromUserName">
                                        <i class="bi bi-arrow-down-left"></i> Delegated: @item.DelegatedFromUserName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400">Direct</span>
                                }
                            </td>
                            <td class="px-5 py-4 text-right">
                                <a asp-action="Action" asp-route-id="@item.ApprovalInstanceId" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-xs transition-colors">
                                    <i class="bi bi-check2-circle"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="px-5 py-12 text-center">
                            <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 inline-flex items-center justify-center text-xl mb-3 mx-auto">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <h3 class="text-sm font-bold text-slate-900 mb-1">All Caught Up!</h3>
                            <p class="text-xs text-slate-500">No pending approval tasks assigned to you or delegated to you.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

