@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto>
@{
    ViewData["Title"] = "Pending Approvals Inbox";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0">Pending Approvals</h4>
        <small class="text-muted">Requests assigned to you or your role awaiting decision</small>
    </div>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-clock-history me-1"></i> @Model.TotalCount Pending</span>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request #</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Requester</th>
                        <th>Priority</th>
                        <th>Total Amount</th>
                        <th>Step</th>
                        <th>Assigned</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.RequestNumber</td>
                                <td class="fw-semibold">@item.RequestTitle</td>
                                <td>@item.RequestTypeName</td>
                                <td>@item.RequesterName</td>
                                <td>
                                    <span class="badge bg-@(item.Priority == RequestPriority.High || item.Priority == RequestPriority.Urgent ? "danger" : "secondary")">@item.Priority</span>
                                </td>
                                <td class="fw-bold">@item.TotalAmount.ToString("N2") @item.Currency</td>
                                <td><span class="badge bg-info text-white">Step @item.StepNumber</span></td>
                                <td>@item.AssignedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="Action" asp-route-id="@item.ApprovalInstanceId" class="btn btn-sm btn-primary py-1 px-3 fw-semibold">
                                        <i class="bi bi-check2-circle me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                                <h6 class="fw-bold">All caught up!</h6>
                                <p class="m-0 small">No pending approval tasks assigned to you.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
