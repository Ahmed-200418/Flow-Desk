@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto>
@using FlowDesk.Domain.Enums
@{
    ViewData["Title"] = "Pending Approvals Inbox";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0"><i class="bi bi-inbox text-primary me-2"></i> Pending Approvals Inbox</h4>
        <small class="text-muted">Requests assigned to you, your role, or delegated to you awaiting decision</small>
    </div>
    <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-clock-history me-1"></i> @Model.TotalCount Pending</span>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request #</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Requester</th>
                        <th>Priority</th>
                        <th>Total Amount</th>
                        <th>Step</th>
                        <th>SLA Status</th>
                        <th>Delegation</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.RequestNumber</td>
                                <td class="fw-semibold">@item.RequestTitle</td>
                                <td>@item.RequestTypeName</td>
                                <td>@item.RequesterName</td>
                                <td>
                                    <span class="badge bg-@(item.Priority == RequestPriority.High || item.Priority == RequestPriority.Urgent ? "danger" : "secondary")">@item.Priority</span>
                                </td>
                                <td class="fw-bold">@item.TotalAmount.ToString("N2") @item.Currency</td>
                                <td><span class="badge bg-info text-white">Step @item.StepNumber</span></td>
                                <td>
                                    @if (item.SlaStatus == "Escalated")
                                    {
                                        <span class="badge text-white" style="background-color: #6f42c1;"><i class="bi bi-graph-up-arrow me-1"></i> Escalated</span>
                                    }
                                    else if (item.SlaStatus == "Overdue")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i> Overdue</span>
                                    }
                                    else if (item.SlaStatus == "Reminder")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-bell me-1"></i> Reminder</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i> On Time</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDelegated)
                                    {
                                        <span class="badge bg-info text-dark" title="Delegated from @item.DelegatedFromUserName">
                                            <i class="bi bi-arrow-down-left me-1"></i> Delegated: @item.DelegatedFromUserName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Direct</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Action" asp-route-id="@item.ApprovalInstanceId" class="btn btn-sm btn-primary py-1 px-3 fw-semibold">
                                        <i class="bi bi-check2-circle me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                                <h6 class="fw-bold">All caught up!</h6>
                                <p class="m-0 small">No pending approval tasks assigned to you or delegated to you.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
