@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Requests.RequestSummaryDto>
@{
    ViewData["Title"] = "My Requests";
    var currentStatus = ViewData["CurrentStatus"] as RequestStatus?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0">My Requests</h4>
        <small class="text-muted">Track all your submitted and draft requests</small>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Create Request</a>
</div>

<!-- Status Navigation Tabs -->
<ul class="nav nav-pills mb-3 border-bottom pb-2">
    <li class="nav-item">
        <a class="nav-link @(currentStatus == null ? "active" : "")" asp-action="Index">All</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == RequestStatus.Draft ? "active" : "")" asp-action="Index" asp-route-status="@RequestStatus.Draft">Drafts</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == RequestStatus.PendingApproval ? "active" : "")" asp-action="Index" asp-route-status="@RequestStatus.PendingApproval">Pending Approval</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == RequestStatus.Returned ? "active" : "")" asp-action="Index" asp-route-status="@RequestStatus.Returned">Returned</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == RequestStatus.Approved ? "active" : "")" asp-action="Index" asp-route-status="@RequestStatus.Approved">Approved</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(currentStatus == RequestStatus.Rejected ? "active" : "")" asp-action="Index" asp-route-status="@RequestStatus.Rejected">Rejected</a>
    </li>
</ul>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request #</th>
                        <th>Type</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var req in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@req.RequestNumber</td>
                                <td>@req.RequestTypeName</td>
                                <td>@req.Title</td>
                                <td>
                                    <span class="badge bg-@(req.Priority == RequestPriority.High || req.Priority == RequestPriority.Urgent ? "danger" : "secondary")">@req.Priority</span>
                                </td>
                                <td>@req.TotalAmount.ToString("N2") @req.Currency</td>
                                <td>
                                    <span class="badge badge-status bg-@req.Status.ToString().ToLower()">@req.Status</span>
                                </td>
                                <td>@req.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary py-0"><i class="bi bi-eye me-1"></i> View</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
