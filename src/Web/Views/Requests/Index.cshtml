@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Requests.RequestSummaryDto>
@{
    ViewData["Title"] = "My Requests";
    var currentStatus = ViewData["CurrentStatus"] as RequestStatus?;
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-file-earmark-text text-emerald-600"></i> My Business Requests
        </h1>
        <p class="text-sm text-slate-500 mt-1">Track all your submitted requests, drafts, and active approval statuses.</p>
    </div>
    <div>
        <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all">
            <i class="bi bi-plus-lg"></i> Create Request
        </a>
    </div>
</div>

<!-- Status Navigation Tabs -->
<div class="flex flex-wrap gap-2 mb-6 border-b border-slate-200 pb-3">
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == null ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index">All Requests</a>
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == RequestStatus.Draft ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index" asp-route-status="@RequestStatus.Draft">Drafts</a>
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == RequestStatus.PendingApproval ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index" asp-route-status="@RequestStatus.PendingApproval">Pending Approval</a>
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == RequestStatus.Returned ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index" asp-route-status="@RequestStatus.Returned">Returned</a>
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == RequestStatus.Approved ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index" asp-route-status="@RequestStatus.Approved">Approved</a>
    <a class="px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors @(currentStatus == RequestStatus.Rejected ? "bg-emerald-600 text-white shadow-xs" : "bg-white border border-slate-200 text-slate-600 hover:bg-slate-50")" asp-action="Index" asp-route-status="@RequestStatus.Rejected">Rejected</a>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    <th class="px-5 py-3.5">Request #</th>
                    <th class="px-5 py-3.5">Type</th>
                    <th class="px-5 py-3.5">Title</th>
                    <th class="px-5 py-3.5">Priority</th>
                    <th class="px-5 py-3.5">Total Amount</th>
                    <th class="px-5 py-3.5">Status</th>
                    <th class="px-5 py-3.5">Created At</th>
                    <th class="px-5 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
                @if (Model.Items.Any())
                {
                    foreach (var req in Model.Items)
                    {
                        var statusBadge = req.Status switch
                        {
                            RequestStatus.Approved => "bg-emerald-100 text-emerald-800 border-emerald-200",
                            RequestStatus.Rejected => "bg-rose-100 text-rose-800 border-rose-200",
                            RequestStatus.PendingApproval => "bg-amber-100 text-amber-800 border-amber-200",
                            RequestStatus.Returned => "bg-orange-100 text-orange-800 border-orange-200",
                            _ => "bg-slate-100 text-slate-700 border-slate-200"
                        };

                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-5 py-4 font-bold text-emerald-700">@req.RequestNumber</td>
                            <td class="px-5 py-4 font-semibold text-slate-900">@req.RequestTypeName</td>
                            <td class="px-5 py-4 text-slate-700">@req.Title</td>
                            <td class="px-5 py-4">
                                @if (req.Priority == RequestPriority.Urgent || req.Priority == RequestPriority.High)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-rose-100 text-rose-800 border border-rose-200"><i class="bi bi-exclamation-triangle"></i>@req.Priority</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">@req.Priority</span>
                                }
                            </td>
                            <td class="px-5 py-4 font-semibold text-slate-900">@req.TotalAmount.ToString("N2") <span class="text-[11px] text-slate-400">@req.Currency</span></td>
                            <td class="px-5 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-semibold border @statusBadge">@req.Status</span>
                            </td>
                            <td class="px-5 py-4 text-slate-500">@req.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-5 py-4 text-right">
                                <div class="inline-flex items-center gap-1">
                                    <a asp-action="Details" asp-route-id="@req.Id" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors" title="View Timeline & Details"><i class="bi bi-eye text-emerald-600"></i> View</a>
                                    @if (req.Status == RequestStatus.Draft || req.Status == RequestStatus.Returned)
                                    {
                                        <form asp-action="Delete" asp-route-id="@req.Id" method="post" class="inline" onsubmit="return confirm('Delete draft request #@req.RequestNumber?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-1 text-slate-400 hover:text-rose-600 transition-colors" title="Delete Draft"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-5 py-12 text-center text-slate-500">No requests found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

