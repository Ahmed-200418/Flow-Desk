@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Audit.AuditLogDto>
@using FlowDesk.Application.Features.Audit
@{
    var stats = ViewData["Stats"] as AuditStatsDto;
    ViewData["Title"] = "Audit Trail & Compliance";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-shield-check text-emerald-600"></i> Audit Trail & Compliance
        </h1>
        <p class="text-sm text-slate-500 mt-1">Immutable system activity, security audit trail, and entity history records.</p>
    </div>
    <div class="flex items-center gap-2">
        <a asp-action="Export"
           asp-route-search="@ViewData["Search"]"
           asp-route-entityName="@ViewData["EntityName"]"
           asp-route-action="@ViewData["Action"]"
           asp-route-fromDate="@ViewData["FromDate"]"
           asp-route-toDate="@ViewData["ToDate"]"
           class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-all shadow-xs">
            <i class="bi bi-file-earmark-spreadsheet text-emerald-600"></i> Export CSV
        </a>
    </div>
</div>

<!-- Stats Cards Grid -->
@if (stats != null)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">TOTAL AUDIT LOGS</span>
                    <div class="text-2xl font-bold text-slate-900 mt-1">@stats.TotalLogs.ToString("N0")</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                    <i class="bi bi-list-columns-reverse"></i>
                </div>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">TODAY'S EVENTS</span>
                    <div class="text-2xl font-bold text-sky-600 mt-1">@stats.TodayLogs.ToString("N0")</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">SECURITY EVENTS</span>
                    <div class="text-2xl font-bold text-amber-600 mt-1">@stats.SecurityEventsCount.ToString("N0")</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                    <i class="bi bi-shield-lock"></i>
                </div>
            </div>
        </div>
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">UNIQUE ACTORS</span>
                    <div class="text-2xl font-bold text-teal-600 mt-1">@stats.UniqueUsersCount.ToString("N0")</div>
                </div>
                <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filter Bar Card -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 mb-6">
    <form method="get" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
        <div class="lg:col-span-3">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Search Keywords</label>
            <div class="relative">
                <i class="bi bi-search absolute left-3.5 top-2.5 text-slate-400 text-sm"></i>
                <input type="text" name="search" class="w-full pl-9 pr-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 text-slate-900" placeholder="Email, IP, action..." value="@ViewData["Search"]" />
            </div>
        </div>
        <div class="lg:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Entity Type</label>
            <input type="text" name="entityName" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 text-slate-900" placeholder="Request, User..." value="@ViewData["EntityName"]" />
        </div>
        <div class="lg:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">Action</label>
            <input type="text" name="action" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 text-slate-900" placeholder="Create, Approve..." value="@ViewData["Action"]" />
        </div>
        <div class="lg:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">From Date</label>
            <input type="datetime-local" name="fromDate" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 text-slate-900" value="@ViewData["FromDate"]" />
        </div>
        <div class="lg:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">To Date</label>
            <input type="datetime-local" name="toDate" class="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/10 text-slate-900" value="@ViewData["ToDate"]" />
        </div>
        <div class="lg:col-span-1">
            <button type="submit" class="w-full py-2 px-3 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-xs transition-colors" title="Apply Filters">
                <i class="bi bi-funnel-fill"></i>
            </button>
        </div>
    </form>
</div>

<!-- Logs Table Card -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden transition-all duration-200 hover:shadow-md">
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <span class="font-bold text-slate-900 text-sm flex items-center gap-2"><i class="bi bi-table text-emerald-600"></i> Audit Records (@Model.TotalCount total)</span>
        <span class="text-xs text-slate-500 flex items-center gap-1"><i class="bi bi-lock-fill text-slate-400"></i> Append-Only Immutable Records</span>
    </div>
    <div class="p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center py-12 text-slate-500">
                <i class="bi bi-shield-x text-4xl text-slate-300"></i>
                <h3 class="mt-2 text-sm font-bold text-slate-900">No Audit Records Found</h3>
                <p class="text-xs text-slate-500 mt-0.5">No system activity matching the specified criteria was logged.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                            <th class="px-5 py-3.5 whitespace-nowrap">Timestamp (UTC)</th>
                            <th class="px-5 py-3.5">Actor</th>
                            <th class="px-5 py-3.5">Action</th>
                            <th class="px-5 py-3.5">Target Entity</th>
                            <th class="px-5 py-3.5 whitespace-nowrap">IP Address</th>
                            <th class="px-5 py-3.5 text-right whitespace-nowrap">Options</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-xs">
                        @foreach (var log in Model.Items)
                        {
                            var badgeClass = "bg-slate-100 text-slate-700 border-slate-200";
                            if (log.Action.Contains("Auth") || log.Action.Contains("Login")) badgeClass = "bg-rose-100 text-rose-800 border-rose-200";
                            else if (log.Action.Contains("Create") || log.Action.Contains("Added")) badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                            else if (log.Action.Contains("Approve")) badgeClass = "bg-sky-100 text-sky-800 border-sky-200";
                            else if (log.Action.Contains("Reject") || log.Action.Contains("Delete")) badgeClass = "bg-amber-100 text-amber-800 border-amber-200";

                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="px-5 py-4 font-mono text-slate-700 whitespace-nowrap">@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td class="px-5 py-4">
                                    @if (!string.IsNullOrEmpty(log.UserEmail))
                                    {
                                        <div class="font-semibold text-slate-900 flex items-center gap-1.5"><i class="bi bi-person text-slate-400"></i>@log.UserEmail</div>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-slate-100 text-slate-600 text-[11px] font-medium border border-slate-200"><i class="bi bi-cpu"></i>System</span>
                                    }
                                </td>
                                <td class="px-5 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border @badgeClass">@log.Action</span>
                                </td>
                                <td class="px-5 py-4">
                                    <div class="font-bold text-slate-900">@log.EntityName</div>
                                    <div class="font-mono text-[10px] text-slate-400">ID: @(log.EntityId.Length > 16 ? log.EntityId.Substring(0, 16) + "..." : log.EntityId)</div>
                                </td>
                                <td class="px-5 py-4 font-mono text-slate-600 whitespace-nowrap">
                                    @(string.IsNullOrEmpty(log.IpAddress) ? "Internal" : log.IpAddress)
                                </td>
                                <td class="px-5 py-4 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <a asp-action="Details" asp-route-id="@log.Id" class="p-1.5 text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="Details">
                                            <i class="bi bi-eye text-base"></i>
                                        </a>
                                        <a asp-action="EntityHistory" asp-route-entityName="@log.EntityName" asp-route-entityId="@log.EntityId" class="p-1.5 text-slate-500 hover:text-sky-600 hover:bg-sky-50 rounded-lg transition-colors" title="History">
                                            <i class="bi bi-clock-history text-base"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
