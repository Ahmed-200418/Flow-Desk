@model List<FlowDesk.Application.Features.Audit.AuditLogDetailDto>
@{
    var entityName = ViewData["EntityName"]?.ToString() ?? "Entity";
    var entityId = ViewData["EntityId"]?.ToString() ?? "";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors mb-2">
            <i class="bi bi-arrow-left"></i> Back to Audit Logs
        </a>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-clock-history text-emerald-600"></i> Audit Timeline History
        </h1>
        <p class="text-sm text-slate-500 mt-1">Entity: <span class="font-bold text-slate-800">@entityName</span> &bull; ID: <span class="font-mono text-xs bg-slate-100 text-slate-800 px-1.5 py-0.5 rounded">@entityId</span></p>
    </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 font-semibold text-slate-800 flex items-center gap-2">
        <i class="bi bi-diagram-2 text-emerald-600"></i> Chronological History (@Model.Count change events)
    </div>
    <div class="p-6">
        @if (!Model.Any())
        {
            <div class="text-center py-12">
                <i class="bi bi-search text-4xl text-slate-400"></i>
                <h3 class="mt-3 text-base font-semibold text-slate-700">No Timeline Events Found</h3>
                <p class="text-sm text-slate-500">No change events logged for @entityName ID '@entityId'.</p>
            </div>
        }
        else
        {
            <div class="relative pl-6 border-l-2 border-emerald-500 space-y-6 my-2 ml-2">
                @foreach (var eventItem in Model)
                {
                    var badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                    if (eventItem.Action.Contains("Create") || eventItem.Action.Contains("Added")) badgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                    else if (eventItem.Action.Contains("Approve")) badgeClass = "bg-teal-100 text-teal-800 border-teal-200";
                    else if (eventItem.Action.Contains("Reject") || eventItem.Action.Contains("Delete")) badgeClass = "bg-rose-100 text-rose-800 border-rose-200";
                    else if (eventItem.Action.Contains("Update") || eventItem.Action.Contains("Modified")) badgeClass = "bg-sky-100 text-sky-800 border-sky-200";

                    <div class="relative pl-6">
                        <div class="absolute -left-[31px] top-1.5 w-3.5 h-3.5 bg-emerald-600 rounded-full border-2 border-white ring-2 ring-emerald-100"></div>
                        
                        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
                            <div class="px-4 py-3 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border @badgeClass">
                                        @eventItem.Action
                                    </span>
                                    <span class="text-sm font-semibold text-slate-900">By: @(eventItem.UserEmail ?? "System")</span>
                                </div>
                                <span class="text-xs text-slate-500 flex items-center gap-1">
                                    <i class="bi bi-clock"></i>@eventItem.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss.fff") UTC
                                </span>
                            </div>
                            <div class="p-4">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    @if (!string.IsNullOrEmpty(eventItem.OldValuesJson))
                                    {
                                        <div>
                                            <div class="text-xs font-semibold text-rose-700 mb-1">Old State:</div>
                                            <pre class="bg-slate-900 text-amber-300 p-3 rounded-lg font-mono text-xs overflow-auto max-h-40"><code>@eventItem.OldValuesJson</code></pre>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(eventItem.NewValuesJson))
                                    {
                                        <div>
                                            <div class="text-xs font-semibold text-emerald-700 mb-1">New State:</div>
                                            <pre class="bg-slate-900 text-emerald-400 p-3 rounded-lg font-mono text-xs overflow-auto max-h-40"><code>@eventItem.NewValuesJson</code></pre>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

