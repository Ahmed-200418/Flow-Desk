@model List<FlowDesk.Application.Features.Audit.AuditLogDetailDto>
@{
    var entityName = ViewData["EntityName"]?.ToString() ?? "Entity";
    var entityId = ViewData["EntityId"]?.ToString() ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2 mb-2"><i class="bi bi-arrow-left me-1"></i> Back to Audit Logs</a>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-clock-history text-info me-2"></i> Audit Timeline History</h3>
        <p class="text-muted mb-0">Entity: <span class="fw-bold">@entityName</span> &bull; ID: <span class="font-monospace">@entityId</span></p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header bg-light">
        <i class="bi bi-diagram-2 me-2"></i> Chronological History (@Model.Count change events)
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search fs-1 text-muted"></i>
                <h5 class="mt-3 text-secondary">No Timeline Events Found</h5>
                <p class="text-muted">No change events logged for @entityName ID '@entityId'.</p>
            </div>
        }
        else
        {
            <div class="timeline ps-3 border-start border-2 border-primary my-2 ms-2">
                @foreach (var eventItem in Model)
                {
                    var badgeClass = "bg-primary";
                    if (eventItem.Action.Contains("Create") || eventItem.Action.Contains("Added")) badgeClass = "bg-success";
                    else if (eventItem.Action.Contains("Approve")) badgeClass = "bg-primary";
                    else if (eventItem.Action.Contains("Reject") || eventItem.Action.Contains("Delete")) badgeClass = "bg-danger";
                    else if (eventItem.Action.Contains("Update") || eventItem.Action.Contains("Modified")) badgeClass = "bg-info text-dark";

                    <div class="timeline-item position-relative mb-4 ps-4">
                        <div class="position-absolute top-0 start-0 translate-middle p-2 bg-primary rounded-circle border border-white" style="left: -1px !important;"></div>
                        
                        <div class="card border shadow-sm">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <span class="badge @badgeClass me-2">@eventItem.Action</span>
                                    <span class="fw-semibold text-dark">By: @(eventItem.UserEmail ?? "System")</span>
                                </div>
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i>@eventItem.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss.fff") UTC</span>
                            </div>
                            <div class="card-body py-2">
                                <div class="row g-2">
                                    @if (!string.IsNullOrEmpty(eventItem.OldValuesJson))
                                    {
                                        <div class="col-md-6">
                                            <div class="small fw-semibold text-danger mb-1">Old State:</div>
                                            <pre class="bg-light p-2 rounded font-monospace small mb-0" style="max-height: 150px; overflow-y: auto;"><code>@eventItem.OldValuesJson</code></pre>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(eventItem.NewValuesJson))
                                    {
                                        <div class="col-md-6">
                                            <div class="small fw-semibold text-success mb-1">New State:</div>
                                            <pre class="bg-light p-2 rounded font-monospace small mb-0" style="max-height: 150px; overflow-y: auto;"><code>@eventItem.NewValuesJson</code></pre>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
