@model FlowDesk.Application.Features.Users.UserDetailDto
@{
    ViewData["Title"] = "User Details";
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-custom mb-4">
            <div class="card-body text-center p-4">
                <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                    @(Model.FirstName.FirstOrDefault())
                </div>
                <h4 class="fw-bold m-0">@Model.FullName</h4>
                <p class="text-muted">@(Model.JobTitle ?? "Employee")</p>
                <span class="badge bg-primary fs-6 px-3 py-2">@Model.Email</span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-custom mb-4">
            <div class="card-header">
                <i class="bi bi-person border-end pe-2 me-2"></i> Account Info
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Department:</div>
                    <div class="col-sm-8 fw-semibold">@(Model.DepartmentName ?? "Unassigned")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Position:</div>
                    <div class="col-sm-8 fw-semibold">@(Model.PositionTitle ?? "Unassigned")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Account Status:</div>
                    <div class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge bg-warning text-dark me-1">Locked Out</span>
                        }
                    </div>
                </div>

                <hr />

                <h6 class="fw-semibold text-muted mb-2">ASSIGNED ROLES</h6>
                <div class="mb-3">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-dark fs-6 me-1 mb-1">@role</span>
                    }
                </div>

                <h6 class="fw-semibold text-muted mb-2">EFFECTIVE PERMISSIONS</h6>
                <div>
                    @foreach (var perm in Model.Permissions)
                    {
                        <span class="badge bg-secondary fs-6 me-1 mb-1">@perm</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
