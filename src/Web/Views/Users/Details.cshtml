@model FlowDesk.Application.Features.Users.UserDetailDto
@{
    ViewData["Title"] = "User Details";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h4 class="fw-bold text-dark m-0">@Model.FullName</h4>
        <p class="text-muted small m-0">User profile details and permissions overview.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom"><i class="bi bi-pencil me-1"></i> Edit Profile</a>
        <a asp-action="Index" class="btn btn-light border"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card card-custom mb-4">
            <div class="card-body text-center p-4">
                <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.2rem; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.25);">
                    @(Model.FirstName.FirstOrDefault())
                </div>
                <h4 class="fw-bold text-dark mb-1">@Model.FullName</h4>
                <p class="text-muted mb-2">@(Model.JobTitle ?? "Employee")</p>
                <span class="badge bg-light text-primary border border-primary border-opacity-25 px-3 py-2 fw-semibold">@Model.Email</span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-custom mb-4">
            <div class="card-header fw-bold">
                <i class="bi bi-person me-2 text-primary"></i> Account & Organizational Info
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Department:</div>
                    <div class="col-sm-8 fw-semibold text-dark">@(Model.DepartmentName ?? "Unassigned")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Position:</div>
                    <div class="col-sm-8 fw-semibold text-dark">@(Model.PositionTitle ?? "Unassigned")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Account Status:</div>
                    <div class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge badge-status bg-approved">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-status bg-rejected">Inactive</span>
                        }
                        @if (Model.IsLockedOut)
                        {
                            <span class="badge bg-warning text-dark me-1">Locked Out</span>
                        }
                    </div>
                </div>

                <hr />

                <h6 class="fw-bold text-muted mb-2 small text-uppercase">Assigned System Roles</h6>
                <div class="mb-4">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 me-1 mb-1 fw-semibold">@role</span>
                    }
                </div>

                <h6 class="fw-bold text-muted mb-2 small text-uppercase">Effective System Permissions</h6>
                <div>
                    @foreach (var perm in Model.Permissions)
                    {
                        <span class="badge bg-light text-dark border px-2 py-1 me-1 mb-1">@perm</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
