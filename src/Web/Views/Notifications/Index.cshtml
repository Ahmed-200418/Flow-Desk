@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Notifications.NotificationDto>
@using FlowDesk.Domain.Enums

@{
    ViewData["Title"] = "Notification Center";
    bool onlyUnread = ViewBag.OnlyUnread ?? false;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-bell me-2 text-primary"></i>Notification Center</h3>
        <p class="text-muted mb-0">View all your workflow, approval, reminder, and escalation alerts.</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Items.Any(n => !n.IsRead))
        {
            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-check2-all me-1"></i> Mark All as Read
                </button>
            </form>
        }
    </div>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(!onlyUnread ? "active fw-bold" : "")" asp-controller="Notifications" asp-action="Index" asp-route-onlyUnread="false">
            All Notifications
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(onlyUnread ? "active fw-bold" : "")" asp-controller="Notifications" asp-action="Index" asp-route-onlyUnread="true">
            Unread Only
        </a>
    </li>
</ul>

@if (!Model.Items.Any())
{
    <div class="card card-custom p-5 text-center">
        <div class="my-4">
            <i class="bi bi-bell-slash text-muted display-4"></i>
            <h5 class="fw-bold mt-3">No Notifications Found</h5>
            <p class="text-muted">You're all caught up! There are no notifications to display at this time.</p>
        </div>
    </div>
}
else
{
    <div class="list-group shadow-sm border rounded-3 mb-4">
        @foreach (var notification in Model.Items)
        {
            var badgeClass = notification.Type switch
            {
                NotificationType.ApprovalRequired => "bg-warning text-dark",
                NotificationType.ApprovalResult => "bg-success",
                NotificationType.Reminder => "bg-info text-dark",
                NotificationType.Escalation => "bg-danger",
                _ => "bg-secondary"
            };

            var iconClass = notification.Type switch
            {
                NotificationType.ApprovalRequired => "bi-clock-history text-warning",
                NotificationType.ApprovalResult => "bi-check-circle-fill text-success",
                NotificationType.Reminder => "bi-alarm text-info",
                NotificationType.Escalation => "bi-exclamation-triangle-fill text-danger",
                _ => "bi-envelope text-primary"
            };

            <div class="list-group-item list-group-item-action p-3 @(!notification.IsRead ? "bg-light border-start border-4 border-primary" : "")">
                <div class="d-flex w-100 justify-content-between align-items-start">
                    <div class="d-flex gap-3 align-items-start">
                        <div class="fs-4 mt-1">
                            <i class="bi @iconClass"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="mb-0 fw-bold">@notification.Title</h6>
                                <span class="badge @badgeClass" style="font-size: 0.7rem;">@notification.Type</span>
                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-primary" style="font-size: 0.65rem;">NEW</span>
                                }
                            </div>
                            <p class="text-secondary mb-1" style="font-size: 0.9rem;">@notification.Message</p>
                            <small class="text-muted" style="font-size: 0.75rem;">
                                <i class="bi bi-clock me-1"></i>@notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC")
                            </small>
                        </div>
                    </div>
                    <div>
                        @if (!notification.IsRead)
                        {
                            <form asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-muted" title="Mark as Read">
                                    <i class="bi bi-check2"></i> Mark Read
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Notifications pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-onlyUnread="@onlyUnread">Previous</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-onlyUnread="@onlyUnread">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-onlyUnread="@onlyUnread">Next</a>
                </li>
            </ul>
        </nav>
    }
}
