@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Notifications.NotificationDto>
@using FlowDesk.Domain.Enums

@{
    ViewData["Title"] = "Notification Center";
    bool onlyUnread = ViewBag.OnlyUnread ?? false;
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-bell text-emerald-600"></i> Notification Center
        </h1>
        <p class="text-sm text-slate-500 mt-1">View all your workflow, approval, reminder, and escalation alerts.</p>
    </div>
    <div class="flex gap-2">
        @if (Model.Items.Any(n => !n.IsRead))
        {
            <form asp-controller="Notifications" asp-action="MarkAllAsRead" method="post" class="inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg hover:bg-emerald-100 transition-colors">
                    <i class="bi bi-check2-all"></i> Mark All as Read
                </button>
            </form>
        }
    </div>
</div>

<!-- Filter Tabs -->
<div class="flex border-b border-slate-200 mb-6">
    <a class="px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors @(!onlyUnread ? "border-emerald-600 text-emerald-700" : "border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300")" asp-controller="Notifications" asp-action="Index" asp-route-onlyUnread="false">
        All Notifications
    </a>
    <a class="px-4 py-2.5 text-sm font-semibold border-b-2 transition-colors @(onlyUnread ? "border-emerald-600 text-emerald-700" : "border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300")" asp-controller="Notifications" asp-action="Index" asp-route-onlyUnread="true">
        Unread Only
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="bg-white border border-slate-200 rounded-xl p-12 text-center shadow-sm">
        <i class="bi bi-bell-slash text-4xl text-slate-400"></i>
        <h3 class="mt-3 text-base font-bold text-slate-900">No Notifications Found</h3>
        <p class="text-sm text-slate-500 mt-1">You're all caught up! There are no notifications to display at this time.</p>
    </div>
}
else
{
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm divide-y divide-slate-100 overflow-hidden mb-6">
        @foreach (var notification in Model.Items)
        {
            var badgeClass = notification.Type switch
            {
                NotificationType.ApprovalRequired => "bg-amber-100 text-amber-800 border-amber-200",
                NotificationType.ApprovalResult => "bg-emerald-100 text-emerald-800 border-emerald-200",
                NotificationType.Reminder => "bg-sky-100 text-sky-800 border-sky-200",
                NotificationType.Escalation => "bg-rose-100 text-rose-800 border-rose-200",
                _ => "bg-slate-100 text-slate-700 border-slate-200"
            };

            var iconClass = notification.Type switch
            {
                NotificationType.ApprovalRequired => "bi-clock-history text-amber-600",
                NotificationType.ApprovalResult => "bi-check-circle-fill text-emerald-600",
                NotificationType.Reminder => "bi-alarm text-sky-600",
                NotificationType.Escalation => "bi-exclamation-triangle-fill text-rose-600",
                _ => "bi-envelope text-emerald-600"
            };

            <div class="p-4 transition-colors hover:bg-slate-50/80 flex items-start justify-between gap-4 @(!notification.IsRead ? "bg-emerald-50/40 border-l-4 border-l-emerald-600" : "")">
                <div class="flex items-start gap-3">
                    <div class="text-xl mt-0.5">
                        <i class="bi @iconClass"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <h4 class="text-sm font-bold text-slate-900">@notification.Title</h4>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-semibold border @badgeClass">@notification.Type</span>
                            @if (!notification.IsRead)
                            {
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white">NEW</span>
                            }
                        </div>
                        <p class="text-xs text-slate-600 mb-1.5">@notification.Message</p>
                        <span class="text-[11px] text-slate-400 flex items-center gap-1">
                            <i class="bi bi-clock"></i>@notification.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC")
                        </span>
                    </div>
                </div>
                <div>
                    @if (!notification.IsRead)
                    {
                        <form asp-controller="Notifications" asp-action="MarkAsRead" asp-route-id="@notification.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-slate-600 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors shadow-sm" title="Mark as Read">
                                <i class="bi bi-check2"></i> Mark Read
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2">
            @if (Model.HasPreviousPage)
            {
                <a class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-onlyUnread="@onlyUnread">Previous</a>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a class="px-3 py-1.5 text-xs font-semibold rounded-lg transition-colors @(i == Model.PageNumber ? "bg-emerald-600 text-white" : "bg-white border border-slate-200 text-slate-700 hover:bg-slate-50")" asp-action="Index" asp-route-pageNumber="@i" asp-route-onlyUnread="@onlyUnread">@i</a>
            }
            @if (Model.HasNextPage)
            {
                <a class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-lg hover:bg-slate-50 transition-colors" asp-action="Index" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-onlyUnread="@onlyUnread">Next</a>
            }
        </div>
    }
}

