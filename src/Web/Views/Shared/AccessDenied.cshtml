@{
    ViewData["Title"] = "Access Denied";
}
<div class="min-h-[50vh] flex flex-col items-center justify-center text-center py-12 px-4">
    <div class="w-20 h-20 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-4xl mb-4 shadow-sm">
        <i class="bi bi-shield-lock-fill"></i>
    </div>
    <h1 class="text-2xl font-bold text-slate-900 mb-2">Access Denied</h1>
    <p class="text-sm text-slate-500 max-w-md mb-6">You do not have permission to access this resource or perform this operation.</p>
    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-colors">
        <i class="bi bi-house-door"></i> Return to Dashboard
    </a>
</div>

