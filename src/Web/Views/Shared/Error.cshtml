@{
    ViewData["Title"] = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-diamond-fill text-warning" style="font-size: 4rem;"></i>
    <h2 class="fw-bold mt-3 text-dark">An error occurred</h2>
    <p class="text-muted">An error occurred while processing your request. Please try again or contact support.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary"><i class="bi bi-house-door me-2"></i> Return to Dashboard</a>
</div>
