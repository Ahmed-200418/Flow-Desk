@using System.Security.Claims
<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlowDesk Enterprise</title>

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Bootstrap Icons CDN for Iconography -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 JS Bundle CDN for Modals & Dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap-grid.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                        },
                        brand: {
                            teal: '#0d9488',
                            emerald: '#059669',
                            slate: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        html, body {
            max-width: 100vw;
            overflow-x: hidden;
        }
        *, ::before, ::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #334155;
            -webkit-font-smoothing: antialiased;
        }

        /* Flex & Grid layout containment */
        .row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -0.5rem;
            margin-left: -0.5rem;
            max-width: 100%;
        }
        .row > * {
            flex-shrink: 0;
            width: 100%;
            max-width: 100%;
            padding-right: 0.5rem;
            padding-left: 0.5rem;
        }
        @@media (min-width: 768px) {
            .col-md-3 { flex: 0 0 auto; width: 25%; }
            .col-md-4 { flex: 0 0 auto; width: 33.33333333%; }
            .col-md-5 { flex: 0 0 auto; width: 41.66666667%; }
            .col-md-6 { flex: 0 0 auto; width: 50%; }
            .col-md-7 { flex: 0 0 auto; width: 58.33333333%; }
            .col-md-8 { flex: 0 0 auto; width: 66.66666667%; }
            .col-md-12 { flex: 0 0 auto; width: 100%; }
        }

        /* Smooth Animations & Keyframes */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-in {
            animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .animate-slide-up {
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Universal Card System */
        .card, .card-custom {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 0.85rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
        }
        .card:hover, .card-custom:hover {
            box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
        }
        .card-header {
            padding: 1rem 1.25rem;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            font-weight: 600;
            color: #0f172a;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .card-body {
            padding: 1.25rem;
        }

        /* Stat Cards */
        .stat-card {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 0.85rem;
            padding: 1.25rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
            transition: all 0.2s ease-in-out;
        }
        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.08);
        }
        .stat-icon {
            width: 3rem;
            height: 3rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
        }

        /* Universal Input Controls */
        .form-control, .form-select, .form-control-custom, .form-select-custom {
            border: 1px solid #cbd5e1;
            border-radius: 0.6rem;
            padding: 0.55rem 0.85rem;
            font-size: 0.875rem;
            color: #0f172a;
            background-color: #ffffff;
            transition: all 0.15s ease-in-out;
            width: 100%;
        }
        .form-control:focus, .form-select:focus, .form-control-custom:focus, .form-select-custom:focus {
            border-color: #059669;
            box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
            outline: none;
        }
        .form-label {
            font-size: 0.825rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 0.35rem;
            display: inline-block;
        }

        /* Input Group */
        .input-group {
            display: flex;
            width: 100%;
        }
        .input-group-text {
            display: flex;
            align-items: center;
            padding: 0.55rem 0.75rem;
            font-size: 0.875rem;
            font-weight: 400;
            color: #64748b;
            text-align: center;
            background-color: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 0.6rem 0 0 0.6rem;
        }
        .input-group > .form-control {
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        /* Universal Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            font-weight: 500;
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            border-radius: 0.6rem;
            transition: all 0.15s ease-in-out;
            cursor: pointer;
            text-decoration: none;
            border: 1px solid transparent;
        }
        .btn-sm {
            padding: 0.35rem 0.75rem;
            font-size: 0.8125rem;
            border-radius: 0.5rem;
        }
        .btn-primary, .btn-primary-custom {
            background-color: #059669;
            color: #ffffff;
            border-color: #059669;
        }
        .btn-primary:hover, .btn-primary-custom:hover {
            background-color: #047857;
            border-color: #047857;
            color: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(5, 150, 105, 0.25);
        }
        .btn-light {
            background-color: #ffffff;
            color: #334155;
            border-color: #e2e8f0;
        }
        .btn-light:hover {
            background-color: #f8fafc;
            color: #0f172a;
            border-color: #cbd5e1;
        }
        .btn-outline-primary {
            background-color: transparent;
            color: #059669;
            border-color: #059669;
        }
        .btn-outline-primary:hover {
            background-color: #ecfdf5;
            color: #047857;
        }
        .btn-outline-success {
            background-color: transparent;
            color: #059669;
            border-color: #a7f3d0;
        }
        .btn-outline-success:hover {
            background-color: #d1fae5;
            color: #047857;
        }
        .btn-group {
            display: inline-flex;
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .btn-group .btn {
            border-radius: 0;
            border-right-width: 0;
        }
        .btn-group .btn:last-child {
            border-right-width: 1px;
        }

        /* Universal Table Styling */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .table, .table-custom {
            width: 100%;
            margin-bottom: 0;
            color: #334155;
            vertical-align: middle;
            border-collapse: separate;
            border-spacing: 0;
        }
        .table th, .table-custom th {
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
        }
        .table td, .table-custom td {
            padding: 0.85rem 1rem;
            font-size: 0.875rem;
            border-bottom: 1px solid #f1f5f9;
            transition: background-color 0.15s ease-in-out;
        }
        .table tbody tr:hover, .table-custom tbody tr:hover {
            background-color: #f8fafc;
        }

        /* Status Badges */
        .badge-status {
            font-weight: 600;
            padding: 0.3rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .badge-status::before {
            content: '';
            display: inline-block;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: currentColor;
        }

        .bg-draft { background-color: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
        .bg-submitted { background-color: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
        .bg-pending { background-color: #fef3c7; color: #d97706; border: 1px solid #fde68a; }
        .bg-approved { background-color: #d1fae5; color: #047857; border: 1px solid #a7f3d0; }
        .bg-rejected { background-color: #ffe4e6; color: #e11d48; border: 1px solid #fecdd3; }
        .bg-returned { background-color: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
        .bg-cancelled { background-color: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800">

<div class="min-h-screen flex w-full max-w-full overflow-x-hidden animate-fade-in">
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-64 fixed top-0 left-0 bottom-0 bg-white border-r border-slate-200 z-50 flex flex-col transition-all duration-200">
            <!-- Brand Header with Custom Logo Icon -->
            <div class="p-4 border-b border-slate-200 flex items-center gap-3 bg-white sticky top-0 z-10">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center shadow-md shadow-emerald-500/20">
                    <!-- FlowDesk SVG Brand Icon -->
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-slate-900 text-base leading-none">FlowDesk</h1>
                    <span class="text-[0.68rem] font-semibold text-emerald-600 tracking-wider uppercase">Enterprise Workflow</span>
                </div>
            </div>

            <!-- Navigation Menu -->
            <div class="flex-grow py-4 overflow-y-auto px-3 space-y-6">
                <!-- CORE WORKSPACE -->
                <div>
                    <div class="px-3 mb-2 text-[0.68rem] font-bold text-slate-400 uppercase tracking-wider">Core Workspace</div>
                    <nav class="space-y-1">
                        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-speedometer2 text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "text-emerald-600" : "text-slate-400")"></i>
                            Dashboard
                        </a>
                        <a asp-controller="Requests" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-file-earmark-text text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Requests" ? "text-emerald-600" : "text-slate-400")"></i>
                            My Requests
                        </a>
                        <a asp-controller="Approvals" asp-action="Inbox" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Approvals" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-check2-square text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Approvals" ? "text-emerald-600" : "text-slate-400")"></i>
                            Pending Approvals
                        </a>
                        <a asp-controller="Notifications" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-bell text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notifications" ? "text-emerald-600" : "text-slate-400")"></i>
                            Notifications
                        </a>
                        <a asp-controller="Reports" asp-action="Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-pie-chart text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "text-emerald-600" : "text-slate-400")"></i>
                            Analytics & Reports
                        </a>
                        <a asp-controller="Delegations" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Delegations" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-person-gear text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Delegations" ? "text-emerald-600" : "text-slate-400")"></i>
                            Delegations
                        </a>
                    </nav>
                </div>

                <!-- WORKFLOW ENGINE -->
                <div>
                    <div class="px-3 mb-2 text-[0.68rem] font-bold text-slate-400 uppercase tracking-wider">Workflow Engine</div>
                    <nav class="space-y-1">
                        <a asp-controller="Workflows" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workflows" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-diagram-2 text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Workflows" ? "text-emerald-600" : "text-slate-400")"></i>
                            Workflows & Builder
                        </a>
                        <a asp-controller="RequestTypes" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "RequestTypes" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-tags text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "RequestTypes" ? "text-emerald-600" : "text-slate-400")"></i>
                            Request Types
                        </a>
                        <a asp-controller="Sla" asp-action="Dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sla" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-clock-history text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sla" ? "text-emerald-600" : "text-slate-400")"></i>
                            SLA & Escalations
                        </a>
                    </nav>
                </div>

                <!-- ADMINISTRATION -->
                <div>
                    <div class="px-3 mb-2 text-[0.68rem] font-bold text-slate-400 uppercase tracking-wider">Administration</div>
                    <nav class="space-y-1">
                        <a asp-controller="Performance" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Performance" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-lightning-charge text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Performance" ? "text-emerald-600" : "text-slate-400")"></i>
                            Redis & Performance
                        </a>
                        <a asp-controller="AuditLogs" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-shield-check text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" ? "text-emerald-600" : "text-slate-400")"></i>
                            Audit Logs
                        </a>
                        <a asp-controller="Jobs" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-cpu text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Jobs" ? "text-emerald-600" : "text-slate-400")"></i>
                            Background Jobs
                        </a>
                        <a asp-controller="Organizations" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Organizations" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-building text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Organizations" ? "text-emerald-600" : "text-slate-400")"></i>
                            Organizations
                        </a>
                        <a asp-controller="Departments" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-diagram-3 text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "text-emerald-600" : "text-slate-400")"></i>
                            Departments
                        </a>
                        <a asp-controller="Positions" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Positions" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-briefcase text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Positions" ? "text-emerald-600" : "text-slate-400")"></i>
                            Positions
                        </a>
                        <a asp-controller="Users" asp-action="Index" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-150 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "bg-emerald-50 text-emerald-700 font-semibold shadow-xs" : "text-slate-600 hover:bg-slate-50 hover:text-emerald-600")">
                            <i class="bi bi-people text-base @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "text-emerald-600" : "text-slate-400")"></i>
                            Users & Roles
                        </a>
                    </nav>
                </div>
            </div>
        </aside>
    }

    <!-- Main Content Area -->
    <div class="flex-grow flex flex-col min-h-screen min-w-0 max-w-full @(User.Identity?.IsAuthenticated ?? false ? "ml-64" : "ml-0") overflow-x-hidden">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <!-- Sticky Glassmorphic Top Header -->
            <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 sm:px-6 py-3.5 flex justify-between items-center shadow-xs w-full max-w-full">
                <div class="flex items-center gap-3 min-w-0">
                    <h2 class="text-lg font-bold text-slate-900 tracking-tight truncate">@ViewData["Title"]</h2>
                </div>

                <div class="flex items-center gap-4">
                    <!-- Notification Bell Link -->
                    <a asp-controller="Notifications" asp-action="Index" id="notification-bell-link" class="relative w-9 h-9 rounded-full bg-slate-100 hover:bg-emerald-50 hover:text-emerald-600 text-slate-600 flex items-center justify-center transition-all duration-150" title="Notifications">
                        <i class="bi bi-bell text-lg"></i>
                        <span id="notification-unread-badge" class="absolute -top-1 -right-1 w-5 h-5 rounded-full bg-rose-500 text-white text-[0.7rem] font-bold flex items-center justify-center hidden">
                            0
                        </span>
                    </a>

                    <!-- User Profile Dropdown Pill -->
                    <div class="relative">
                        <button id="user-dropdown-button" onclick="toggleUserDropdown(event)" class="flex items-center gap-2.5 pl-2 pr-3 py-1 rounded-full border border-slate-200 bg-white hover:border-emerald-500 hover:shadow-sm transition-all duration-150 focus:outline-none" type="button">
                            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shadow-xs">
                                @(User.FindFirstValue(ClaimTypes.GivenName)?.FirstOrDefault() ?? 'U')
                            </div>
                            <div class="text-left hidden sm:block">
                                <div class="text-xs font-semibold text-slate-800 leading-none">@User.Identity.Name</div>
                                <div class="text-[0.68rem] text-slate-500 mt-0.5">@User.FindFirstValue(ClaimTypes.Email)</div>
                            </div>
                            <i class="bi bi-chevron-down text-xs text-slate-400"></i>
                        </button>
                        <div id="user-dropdown-menu" class="hidden absolute right-0 mt-2 w-56 bg-white rounded-xl shadow-xl border border-slate-200 p-1.5 z-50">
                            <a class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 rounded-lg transition-colors" asp-controller="Notifications" asp-action="Index">
                                <i class="bi bi-bell text-emerald-600"></i> Notifications
                            </a>
                            <a class="flex items-center gap-2.5 px-3 py-2 text-sm text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 rounded-lg transition-colors" asp-controller="Auth" asp-action="Profile">
                                <i class="bi bi-person text-emerald-600"></i> My Profile
                            </a>
                            <hr class="my-1 border-slate-200">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-rose-600 hover:bg-rose-50 rounded-lg font-medium transition-colors">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>
        }

        <!-- Page Body Container -->
        <main class="flex-grow p-4 sm:p-6 bg-slate-50/50 w-full min-w-0 max-w-full overflow-x-hidden">
            <!-- Toast & Alert Banners -->
            @if (TempData["Success"] != null)
            {
                <div class="mb-5 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-xs" role="alert">
                    <div class="flex items-center gap-3">
                        <i class="bi bi-check-circle-fill text-emerald-600 text-xl"></i>
                        <span class="font-medium text-sm">@TempData["Success"]</span>
                    </div>
                    <button type="button" class="text-emerald-600 hover:text-emerald-800" onclick="this.parentElement.remove();">&times;</button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="mb-5 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center justify-between shadow-xs" role="alert">
                    <div class="flex items-center gap-3">
                        <i class="bi bi-exclamation-triangle-fill text-rose-600 text-xl"></i>
                        <span class="font-medium text-sm">@TempData["Error"]</span>
                    </div>
                    <button type="button" class="text-rose-600 hover:text-rose-800" onclick="this.parentElement.remove();">&times;</button>
                </div>
            }

            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-slate-200 py-3.5 px-6 text-center text-xs text-slate-500">
            &copy; 2026 FlowDesk Enterprise Platform &bull; Clean Architecture Workflow Engine
        </footer>
    </div>
</div>

<script>
    function toggleUserDropdown(event) {
        event.stopPropagation();
        var menu = document.getElementById("user-dropdown-menu");
        if (menu) {
            menu.classList.toggle("hidden");
        }
    }

    document.addEventListener("click", function (e) {
        var menu = document.getElementById("user-dropdown-menu");
        var btn = document.getElementById("user-dropdown-button");
        if (menu && !menu.classList.contains("hidden")) {
            if (btn && !btn.contains(e.target) && !menu.contains(e.target)) {
                menu.classList.add("hidden");
            }
        }
    });

    // Fetch unread notification count asynchronously
    document.addEventListener("DOMContentLoaded", function () {
        var badge = document.getElementById("notification-unread-badge");
        if (badge) {
            fetch('/Notifications/UnreadCount')
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data && data.count > 0) {
                        badge.innerText = data.count;
                        badge.classList.remove("hidden");
                    }
                })
                .catch(function (err) { console.error("Could not fetch unread notifications count", err); });
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

