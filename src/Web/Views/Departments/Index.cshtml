@model List<FlowDesk.Application.Features.Departments.DepartmentDto>
@{
    ViewData["Title"] = "Departments Management";
    var orgs = ViewBag.Organizations as List<FlowDesk.Application.Features.Organizations.OrganizationDto> ?? new List<FlowDesk.Application.Features.Organizations.OrganizationDto>();
    var selectedOrgId = (Guid)ViewBag.SelectedOrgId;
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-diagram-3 text-emerald-600"></i> Departments
        </h1>
        <p class="text-sm text-slate-500 mt-1">Manage enterprise organizational hierarchy & team structure.</p>
    </div>
    @if (selectedOrgId != Guid.Empty)
    {
        <div>
            <a asp-action="Create" asp-route-organizationId="@selectedOrgId" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
                <i class="bi bi-plus-lg"></i> Add Department
            </a>
        </div>
    }
</div>

<!-- Organization Selector Bar -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-4 mb-6">
    <form method="get" class="flex flex-col sm:flex-row items-center gap-3">
        <label class="text-xs font-bold text-slate-500 uppercase tracking-wider whitespace-nowrap flex items-center gap-1.5">
            <i class="bi bi-building text-emerald-600"></i> Organization:
        </label>
        <select name="organizationId" class="w-full sm:w-80 px-4 py-2 text-sm rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-slate-900 bg-white" onchange="this.form.submit()">
            @foreach (var org in orgs)
            {
                <option value="@org.Id" selected="@(org.Id == selectedOrgId)">@org.Name (@org.Code)</option>
            }
        </select>
    </form>
</div>

<!-- Departments Table Card -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden transition-all duration-200 hover:shadow-md">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                    <th class="px-5 py-3.5">Code</th>
                    <th class="px-5 py-3.5">Department Name</th>
                    <th class="px-5 py-3.5">Parent Department</th>
                    <th class="px-5 py-3.5">Department Manager</th>
                    <th class="px-5 py-3.5">Created</th>
                    <th class="px-5 py-3.5 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-xs">
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-5 py-4 font-bold text-slate-800 whitespace-nowrap">
                                <span class="px-2.5 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-mono text-[11px]">@item.Code</span>
                            </td>
                            <td class="px-5 py-4 font-semibold text-slate-900">@item.Name</td>
                            <td class="px-5 py-4 text-slate-600">@(item.ParentDepartmentName ?? "-")</td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                @if (!string.IsNullOrEmpty(item.ManagerUserName))
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-50 text-sky-700 border border-sky-200">
                                        <i class="bi bi-person"></i> @item.ManagerUserName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-slate-400 italic">Not Assigned</span>
                                }
                            </td>
                            <td class="px-5 py-4 text-slate-500 whitespace-nowrap">@item.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td class="px-5 py-4 text-right whitespace-nowrap">
                                <div class="inline-flex items-center justify-end gap-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="Details">
                                        <i class="bi bi-eye text-base"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="Edit">
                                        <i class="bi bi-pencil text-base"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" asp-route-organizationId="@item.OrganizationId" method="post" class="inline" onsubmit="return confirm('Are you sure you want to delete department @item.Name?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete">
                                            <i class="bi bi-trash text-base"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-5 py-12 text-center text-slate-500">No departments found for this organization.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
