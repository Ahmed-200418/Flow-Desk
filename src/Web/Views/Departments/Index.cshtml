@model List<FlowDesk.Application.Features.Departments.DepartmentDto>
@{
    ViewData["Title"] = "Departments Management";
    var orgs = ViewBag.Organizations as List<FlowDesk.Application.Features.Organizations.OrganizationDto> ?? new List<FlowDesk.Application.Features.Organizations.OrganizationDto>();
    var selectedOrgId = (Guid)ViewBag.SelectedOrgId;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold m-0">Departments</h4>
        <small class="text-muted">Manage department hierarchy</small>
    </div>
    @if (selectedOrgId != Guid.Empty)
    {
        <a asp-action="Create" asp-route-organizationId="@selectedOrgId" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Add Department</a>
    }
</div>

<div class="card card-custom mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="fw-semibold">Organization:</label>
            </div>
            <div class="col-md-4">
                <select name="organizationId" class="form-select" onchange="this.form.submit()">
                    @foreach (var org in orgs)
                    {
                        <option value="@org.Id" selected="@(org.Id == selectedOrgId)">@org.Name (@org.Code)</option>
                    }
                </select>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Department Name</th>
                        <th>Parent Department</th>
                        <th>Manager</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@item.Code</span></td>
                                <td class="fw-semibold">@item.Name</td>
                                <td>@(item.ParentDepartmentName ?? "-")</td>
                                <td>@(item.ManagerUserName ?? "-")</td>
                                <td>@item.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No departments found for this organization.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
