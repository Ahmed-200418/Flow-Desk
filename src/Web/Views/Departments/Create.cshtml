@{
    ViewData["Title"] = "Create Department";
    var orgId = (Guid)ViewBag.OrganizationId;
    var depts = ViewBag.Departments as List<FlowDesk.Application.Features.Departments.DepartmentDto> ?? new List<FlowDesk.Application.Features.Departments.DepartmentDto>();
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom">
            <div class="card-header">
                <i class="bi bi-diagram-3 me-2 text-primary"></i> Create Department
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="organizationId" value="@orgId" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2 small">
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Finance" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department Code</label>
                        <input type="text" name="code" class="form-control" placeholder="e.g. FIN" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Parent Department (Optional)</label>
                        <select name="parentDepartmentId" class="form-select">
                            <option value="">-- None (Top Level) --</option>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Id">@d.Name (@d.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" asp-route-organizationId="@orgId" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save Department</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
