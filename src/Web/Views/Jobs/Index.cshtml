@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Background Processing Jobs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-cpu me-2 text-primary"></i>Background Processing & Jobs</h3>
        <p class="text-muted mb-0">Monitor, observe, and trigger background tasks, recurring SLA checks, reminders, and cleanup jobs.</p>
    </div>
    <div>
        <a href="/hangfire" target="_blank" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-speedometer me-1"></i> Open Hangfire Dashboard <i class="bi bi-box-arrow-up-right ms-1 small"></i>
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase font-monospace fw-bold">Processing Engine</span>
                    <h5 class="fw-bold mt-1 mb-0">@ViewBag.Engine</h5>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-circle">
                    <i class="bi bi-gear-wide-connected fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase font-monospace fw-bold">Engine Status</span>
                    <h5 class="fw-bold mt-1 mb-0 text-success"><i class="bi bi-check-circle-fill me-1"></i> Operational</h5>
                </div>
                <div class="p-3 bg-success bg-opacity-10 text-success rounded-circle">
                    <i class="bi bi-activity fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom p-3 border-start border-4 border-info">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase font-monospace fw-bold">Server UTC Time</span>
                    <h5 class="fw-bold mt-1 mb-0">@(((DateTime)ViewBag.SystemTime).ToString("yyyy-MM-dd HH:mm:ss"))</h5>
                </div>
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom shadow-sm mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h6 class="m-0 fw-bold"><i class="bi bi-list-task me-2 text-primary"></i>Configured Recurring Background Jobs</h6>
        <span class="badge bg-secondary">@Model.Count() Active Schedules</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Job Name</th>
                        <th>Schedule</th>
                        <th>Status</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-arrow-repeat text-primary me-2"></i>@job.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border"><i class="bi bi-calendar3 me-1"></i>@job.Schedule</span>
                            </td>
                            <td>
                                <span class="badge bg-success"><i class="bi bi-play-circle-fill me-1"></i>@job.Status</span>
                            </td>
                            <td class="text-muted small">@job.Description</td>
                            <td class="text-end">
                                <form asp-controller="Jobs" asp-action="Trigger" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="jobName" value="@job.Name" />
                                    <button type="submit" class="btn btn-sm btn-primary">
                                        <i class="bi bi-play-fill me-1"></i> Run Now
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
