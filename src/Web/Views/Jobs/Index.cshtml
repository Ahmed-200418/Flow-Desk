@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Background Processing Jobs";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-cpu text-emerald-600"></i> Background Processing & Jobs
        </h1>
        <p class="text-sm text-slate-500 mt-1">Monitor, observe, and trigger background tasks, recurring SLA checks, reminders, and cleanup jobs.</p>
    </div>
    <div>
        <a href="/hangfire" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-xl hover:bg-emerald-100 transition-colors shadow-sm">
            <i class="bi bi-speedometer"></i> Open Hangfire Dashboard <i class="bi bi-box-arrow-up-right text-xs"></i>
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm border-l-4 border-l-emerald-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-mono font-semibold text-slate-400 uppercase tracking-wider">Processing Engine</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1">@ViewBag.Engine</h3>
            </div>
            <div class="p-3 bg-emerald-50 text-emerald-600 rounded-xl">
                <i class="bi bi-gear-wide-connected text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm border-l-4 border-l-teal-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-mono font-semibold text-slate-400 uppercase tracking-wider">Engine Status</span>
                <h3 class="text-lg font-bold text-teal-700 mt-1 flex items-center gap-1.5">
                    <i class="bi bi-check-circle-fill"></i> Operational
                </h3>
            </div>
            <div class="p-3 bg-teal-50 text-teal-600 rounded-xl">
                <i class="bi bi-activity text-xl"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm border-l-4 border-l-sky-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-mono font-semibold text-slate-400 uppercase tracking-wider">Server UTC Time</span>
                <h3 class="text-lg font-bold text-slate-900 mt-1">@(((DateTime)ViewBag.SystemTime).ToString("yyyy-MM-dd HH:mm:ss"))</h3>
            </div>
            <div class="p-3 bg-sky-50 text-sky-600 rounded-xl">
                <i class="bi bi-clock-history text-xl"></i>
            </div>
        </div>
    </div>
</div>

<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-list-task text-emerald-600"></i> Configured Recurring Background Jobs
        </h2>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
            @Model.Count() Active Schedules
        </span>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    <th class="px-5 py-3">Job Name</th>
                    <th class="px-5 py-3">Schedule</th>
                    <th class="px-5 py-3">Status</th>
                    <th class="px-5 py-3">Description</th>
                    <th class="px-5 py-3 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm">
                @foreach (var job in Model)
                {
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-5 py-4 font-bold text-slate-900">
                            <i class="bi bi-arrow-repeat text-emerald-600 me-2"></i>@job.Name
                        </td>
                        <td class="px-5 py-4">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-mono font-medium bg-slate-100 text-slate-700 border border-slate-200">
                                <i class="bi bi-calendar3"></i>@job.Schedule
                            </span>
                        </td>
                        <td class="px-5 py-4">
                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                <i class="bi bi-play-circle-fill"></i>@job.Status
                            </span>
                        </td>
                        <td class="px-5 py-4 text-xs text-slate-500 max-w-xs">@job.Description</td>
                        <td class="px-5 py-4 text-right">
                            <form asp-controller="Jobs" asp-action="Trigger" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="jobName" value="@job.Name" />
                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-sm transition-colors">
                                    <i class="bi bi-play-fill"></i> Run Now
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

