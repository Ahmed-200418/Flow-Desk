@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Sla.OverdueApprovalDto>
@using FlowDesk.Application.Features.Sla

@{
    var metrics = ViewBag.Metrics as SlaMetricsDto ?? new SlaMetricsDto(0, 0, 0, 0, 0);
    ViewData["Title"] = "SLA & Escalations";
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
        <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="bi bi-clock-history text-rose-600"></i> SLA & Escalations Control Center
        </h1>
        <p class="text-sm text-slate-500 mt-1">Monitor workflow approval timeliness, reminders, and auto-escalated bottlenecks.</p>
    </div>
    <div>
        <form asp-action="Process" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-amber-900 bg-amber-400 hover:bg-amber-300 rounded-xl transition-all shadow-sm hover:-translate-y-0.5">
                <i class="bi bi-lightning-charge-fill"></i> Trigger SLA Engine
            </button>
        </form>
    </div>
</div>

<!-- SLA Metrics Cards Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all border-l-4 border-l-emerald-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Pending</span>
                <div class="text-3xl font-bold text-slate-900 mt-1">@metrics.TotalPending</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                <i class="bi bi-hourglass-split"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all border-l-4 border-l-teal-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">On-Time</span>
                <div class="text-3xl font-bold text-teal-700 mt-1">@metrics.TotalOnTime</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
                <i class="bi bi-check-circle"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all border-l-4 border-l-amber-500">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Reminder Sent</span>
                <div class="text-3xl font-bold text-amber-600 mt-1">@metrics.TotalReminder</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                <i class="bi bi-bell"></i>
            </div>
        </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition-all border-l-4 border-l-rose-600">
        <div class="flex items-center justify-between">
            <div>
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Overdue / Escalated</span>
                <div class="text-3xl font-bold text-rose-700 mt-1">@(metrics.TotalOverdue + metrics.TotalEscalated)</div>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Approvals Table -->
<div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden transition-all duration-200 hover:shadow-md">
    <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <i class="bi bi-exclamation-triangle text-rose-600"></i> Overdue Approvals & Escalation Queue
        </h2>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-200">
            @Model.TotalCount Overdue Items
        </span>
    </div>
    @if (!Model.Items.Any())
    {
        <div class="p-12 text-center">
            <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 inline-flex items-center justify-center text-2xl mb-3 border border-emerald-100">
                <i class="bi bi-emoji-smile"></i>
            </div>
            <h3 class="text-base font-bold text-slate-900">No Overdue Approvals!</h3>
            <p class="text-xs text-slate-500 mt-1">All pending approvals across the organization are progressing within their configured SLA limits.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                        <th class="px-5 py-3.5 whitespace-nowrap">Request #</th>
                        <th class="px-5 py-3.5 min-w-[220px]">Title & Type</th>
                        <th class="px-5 py-3.5 min-w-[140px]">Requester</th>
                        <th class="px-5 py-3.5 min-w-[150px]">Assigned Approver</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Step</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Assigned At</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Due Date</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">Overdue By</th>
                        <th class="px-5 py-3.5 whitespace-nowrap">SLA Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    @foreach (var item in Model.Items)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="px-5 py-4 font-bold text-emerald-700 whitespace-nowrap">@item.RequestNumber</td>
                            <td class="px-5 py-4 min-w-[220px]">
                                <div class="font-bold text-slate-900 leading-snug">@item.RequestTitle</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">@item.RequestTypeName</div>
                            </td>
                            <td class="px-5 py-4 text-slate-700 min-w-[140px]">@item.RequesterName</td>
                            <td class="px-5 py-4 font-semibold text-slate-900 min-w-[150px]">@item.AssignedApproverName</td>
                            <td class="px-5 py-4 text-slate-600 whitespace-nowrap">
                                <span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 font-medium">Step @item.StepNumber</span>
                            </td>
                            <td class="px-5 py-4 text-slate-500 whitespace-nowrap">@item.AssignedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-5 py-4 text-rose-700 font-semibold whitespace-nowrap">@item.DueAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-100 text-rose-800 border border-rose-200">
                                    +@item.HoursOverdue hrs
                                </span>
                            </td>
                            <td class="px-5 py-4 whitespace-nowrap">
                                @if (item.IsEscalated)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rose-700 text-white shadow-xs">
                                        <i class="bi bi-graph-up-arrow"></i> Escalated
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                                        <i class="bi bi-alarm"></i> Overdue
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
