@model FlowDesk.Application.Common.Models.PaginatedList<FlowDesk.Application.Features.Sla.OverdueApprovalDto>
@using FlowDesk.Application.Features.Sla

@{
    var metrics = ViewBag.Metrics as SlaMetricsDto ?? new SlaMetricsDto(0, 0, 0, 0, 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-danger me-2"></i> SLA & Escalations Control Center</h3>
        <p class="text-muted mb-0">Monitor workflow approval timeliness, reminders, and auto-escalated bottlenecks.</p>
    </div>
    <div>
        <form asp-action="Process" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning text-dark fw-semibold">
                <i class="bi bi-lightning-charge me-1"></i> Trigger SLA & Escalation Engine
            </button>
        </form>
    </div>
</div>

<!-- SLA Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Total Pending</div>
                    <h2 class="fw-bold text-dark mb-0">@metrics.TotalPending</h2>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">On-Time</div>
                    <h2 class="fw-bold text-success mb-0">@metrics.TotalOnTime</h2>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Reminder Due / Sent</div>
                    <h2 class="fw-bold text-warning mb-0">@metrics.TotalReminder</h2>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="bi bi-bell fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Overdue / Escalated</div>
                    <h2 class="fw-bold text-danger mb-0">@(metrics.TotalOverdue + metrics.TotalEscalated)</h2>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                    <i class="bi bi-exclamation-octagon fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Overdue Approvals Table -->
<div class="card card-custom">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <h5 class="m-0 fw-bold"><i class="bi bi-exclamation-triangle text-danger me-2"></i> Overdue Approvals & Escalation Queue</h5>
        <span class="badge bg-danger">@Model.TotalCount Overdue Items</span>
    </div>
    @if (!Model.Items.Any())
    {
        <div class="p-5 text-center">
            <i class="bi bi-emoji-smile text-success display-4 mb-3"></i>
            <h5>No Overdue Approvals!</h5>
            <p class="text-muted mb-0">All pending approvals across the organization are progressing within their configured SLA limits.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request #</th>
                        <th>Title & Type</th>
                        <th>Requester</th>
                        <th>Assigned Approver</th>
                        <th>Step #</th>
                        <th>Assigned At (UTC)</th>
                        <th>Due Date (UTC)</th>
                        <th>Overdue By</th>
                        <th>SLA Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@item.RequestNumber</td>
                            <td>
                                <div>@item.RequestTitle</div>
                                <small class="text-muted">@item.RequestTypeName</small>
                            </td>
                            <td>@item.RequesterName</td>
                            <td class="fw-semibold">@item.AssignedApproverName</td>
                            <td>Step @item.StepNumber</td>
                            <td class="small">@item.AssignedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="small text-danger fw-semibold">@item.DueAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge bg-danger-subtle text-danger fw-bold">+@item.HoursOverdue hrs</span>
                            </td>
                            <td>
                                @if (item.IsEscalated)
                                {
                                    <span class="badge bg-purple text-white" style="background-color: #6f42c1;"><i class="bi bi-graph-up-arrow me-1"></i> Escalated</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-alarm me-1"></i> Overdue</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
