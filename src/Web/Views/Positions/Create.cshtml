@{
    ViewData["Title"] = "Create Position";
    var deptId = (Guid)ViewBag.DepartmentId;
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom">
            <div class="card-header">
                <i class="bi bi-briefcase me-2 text-primary"></i> Create Position
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="departmentId" value="@deptId" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger p-2 small">
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Position Title</label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Senior Financial Analyst" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Position Code</label>
                        <input type="text" name="code" class="form-control" placeholder="e.g. SFA" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Hierarchy Level</label>
                        <input type="number" name="level" value="1" min="1" max="10" class="form-control" required />
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" asp-route-departmentId="@deptId" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Save Position</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
