@{
    ViewData["Title"] = "Dashboard Overview";
    var recentRequests = ViewBag.RecentRequests as List<FlowDesk.Application.Features.Requests.RequestSummaryDto> ?? new List<FlowDesk.Application.Features.Requests.RequestSummaryDto>();
    var pendingApprovals = ViewBag.PendingApprovals as List<FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto> ?? new List<FlowDesk.Application.Features.Approvals.PendingApprovalSummaryDto>();
}

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">MY REQUESTS</div>
                    <div class="fs-2 fw-bold text-dark">@ViewBag.MyRequestsCount</div>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="bi bi-file-earmark-text fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">PENDING APPROVALS</div>
                    <div class="fs-2 fw-bold text-dark">@ViewBag.PendingApprovalsCount</div>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="bi bi-clock-history fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">QUICK ACTION</div>
                    <a asp-controller="Requests" asp-action="Create" class="btn btn-sm btn-success mt-1"><i class="bi bi-plus-circle me-1"></i> New Request</a>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="bi bi-plus-lg fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small fw-semibold">WORKFLOW ENGINE</div>
                    <a asp-controller="Workflows" asp-action="Index" class="btn btn-sm btn-info text-white mt-1"><i class="bi bi-diagram-2 me-1"></i> Workflows</a>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="bi bi-diagram-3 fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Pending Approvals Widget -->
    <div class="col-md-6 mb-4">
        <div class="card card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-check2-square text-warning me-2"></i> Pending My Approval</span>
                <a asp-controller="Approvals" asp-action="Inbox" class="btn btn-sm btn-outline-primary">View Inbox (@ViewBag.PendingApprovalsCount)</a>
            </div>
            <div class="card-body p-0">
                @if (pendingApprovals.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Requester</th>
                                    <th>Amount</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in pendingApprovals)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.RequestNumber</td>
                                        <td>@item.RequestTitle</td>
                                        <td>@item.RequesterName</td>
                                        <td>@item.TotalAmount.ToString("N2") @item.Currency</td>
                                        <td>
                                            <a asp-controller="Approvals" asp-action="Action" asp-route-id="@item.ApprovalInstanceId" class="btn btn-sm btn-primary py-0">Review</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-check-circle fs-2 text-success"></i>
                        <p class="m-0 mt-2">No pending approvals requiring your action.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Requests Widget -->
    <div class="col-md-6 mb-4">
        <div class="card card-custom">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-earmark-text text-primary me-2"></i> Recent Requests</span>
                <a asp-controller="Requests" asp-action="Index" class="btn btn-sm btn-outline-primary">All Requests</a>
            </div>
            <div class="card-body p-0">
                @if (recentRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Request #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in recentRequests)
                                {
                                    <tr>
                                        <td class="fw-semibold">@req.RequestNumber</td>
                                        <td>@req.Title</td>
                                        <td>
                                            <span class="badge badge-status bg-@req.Status.ToString().ToLower()">@req.Status</span>
                                        </td>
                                        <td>@req.TotalAmount.ToString("N2") @req.Currency</td>
                                        <td>
                                            <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-light border py-0"><i class="bi bi-eye"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2"></i>
                        <p class="m-0 mt-2">No requests created yet. <a asp-controller="Requests" asp-action="Create">Create your first request</a>.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
