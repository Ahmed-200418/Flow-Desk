@model FlowDesk.Application.Features.Auth.DTOs.UserDto
@{
    ViewData["Title"] = "User Profile";
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-custom mb-4">
            <div class="card-body text-center p-4">
                <div class="user-avatar mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                    @(Model.FirstName.FirstOrDefault())
                </div>
                <h4 class="fw-bold m-0">@Model.FullName</h4>
                <p class="text-muted">@(Model.JobTitle ?? "Employee")</p>
                <span class="badge bg-primary fs-6 px-3 py-2">@Model.Email</span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card card-custom mb-4">
            <div class="card-header">
                <i class="bi bi-shield-check me-2 text-primary"></i> Assigned Roles & Permissions
            </div>
            <div class="card-body">
                <h6 class="fw-semibold text-muted mb-2">ROLES</h6>
                <div class="mb-4">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge bg-dark fs-6 me-1 mb-1">@role</span>
                    }
                </div>

                <h6 class="fw-semibold text-muted mb-2">PERMISSIONS</h6>
                <div>
                    @foreach (var perm in Model.Permissions)
                    {
                        <span class="badge bg-secondary fs-6 me-1 mb-1">@perm</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
