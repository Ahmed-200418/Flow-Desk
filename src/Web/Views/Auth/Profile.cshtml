@model FlowDesk.Application.Features.Auth.DTOs.UserDto
@{
    ViewData["Title"] = "User Profile";
}

<div class="grid grid-cols-1 md:grid-cols-12 gap-6">
    <div class="md:col-span-4">
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm p-6 text-center">
            <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-2xl border-2 border-emerald-500 shadow-sm">
                @(Model.FirstName.FirstOrDefault())
            </div>
            <h2 class="text-xl font-bold text-slate-900">@Model.FullName</h2>
            <p class="text-sm text-slate-500 mb-4">@(Model.JobTitle ?? "Employee")</p>
            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                <i class="bi bi-envelope me-1.5"></i> @Model.Email
            </span>
        </div>
    </div>

    <div class="md:col-span-8">
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="px-5 py-4 bg-slate-50 border-b border-slate-200 font-semibold text-slate-800 flex items-center gap-2">
                <i class="bi bi-shield-check text-emerald-600"></i> Assigned Roles & Permissions
            </div>
            <div class="p-6">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Roles</h3>
                <div class="flex flex-wrap gap-2 mb-6">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold bg-slate-900 text-white">
                            <i class="bi bi-shield me-1.5 text-emerald-400"></i> @role
                        </span>
                    }
                </div>

                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Permissions</h3>
                <div class="flex flex-wrap gap-2">
                    @foreach (var perm in Model.Permissions)
                    {
                        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
                            @perm
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

