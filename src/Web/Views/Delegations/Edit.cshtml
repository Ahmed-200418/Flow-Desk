@model FlowDesk.Application.Features.Delegations.DelegationDto
@{
    ViewData["Title"] = "Edit Delegation";
}

<div class="max-w-2xl mx-auto w-full min-w-0 animate-slide-up">
    <!-- Header -->
    <div class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
                <i class="bi bi-pencil-square text-emerald-600"></i> Edit Approval Delegation
            </h1>
            <p class="text-sm text-slate-500 mt-1">Update delegation duration or reason notes.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl transition-all shadow-xs">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-medium">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Delegatee</label>
                <input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-100 text-sm text-slate-500 cursor-not-allowed" value="@Model.DelegateeName (@Model.DelegateeEmail)" readonly disabled />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Start Date (UTC) <span class="text-rose-500">*</span></label>
                    <input type="datetime-local" name="startDateUtc" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" value="@Model.StartDateUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">End Date (UTC) <span class="text-rose-500">*</span></label>
                    <input type="datetime-local" name="endDateUtc" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all" value="@Model.EndDateUtc.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Reason / Notes <span class="text-rose-500">*</span></label>
                <textarea name="reason" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10 text-sm text-slate-900 bg-white transition-all resize-y" required>@Model.Reason</textarea>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-all">Cancel</a>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-md shadow-emerald-600/20 transition-all hover:-translate-y-0.5">
                    <i class="bi bi-check-lg"></i> Update Delegation
                </button>
            </div>
        </form>
    </div>
</div>
