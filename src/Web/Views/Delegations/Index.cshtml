@model List<FlowDesk.Application.Features.Delegations.DelegationDto>
@using FlowDesk.Application.Common.Models
@using FlowDesk.Application.Features.Delegations

@{
    var includeInactive = (bool)(ViewData["IncludeInactive"] ?? false);
    var allDelegations = ViewBag.AllDelegations as PaginatedList<DelegationDto>;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-person-gear text-primary me-2"></i> Approval Delegations</h3>
        <p class="text-muted mb-0">Delegate your approval authority during leave or out-of-office periods.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" asp-route-includeInactive="@(!includeInactive)" class="btn btn-outline-secondary">
            <i class="bi bi-filter me-1"></i> @(includeInactive ? "Show Active Only" : "Include Past & Cancelled")
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Delegation
        </a>
    </div>
</div>

<ul class="nav nav-tabs mb-4" id="delegationTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-semibold" id="my-delegations-tab" data-bs-toggle="tab" data-bs-target="#my-delegations" type="button" role="tab">
            <i class="bi bi-person-badge me-1"></i> My Delegations (@Model.Count)
        </button>
    </li>
    @if (allDelegations != null)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="admin-delegations-tab" data-bs-toggle="tab" data-bs-target="#admin-delegations" type="button" role="tab">
                <i class="bi bi-shield-check me-1"></i> Admin View: All Delegations (@allDelegations.TotalCount)
            </button>
        </li>
    }
</ul>

<div class="tab-content" id="delegationTabsContent">
    <!-- Tab 1: My Delegations -->
    <div class="tab-pane fade show active" id="my-delegations" role="tabpanel">
        @if (!Model.Any())
        {
            <div class="card card-custom p-5 text-center">
                <i class="bi bi-person-x text-muted display-4 mb-3"></i>
                <h5>No delegations found</h5>
                <p class="text-muted">You have no active or scheduled approval delegations.</p>
                <div>
                    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> Create Delegation</a>
                </div>
            </div>
        }
        else
        {
            <div class="card card-custom">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Role / Context</th>
                                <th>Delegator</th>
                                <th>Delegatee</th>
                                <th>Scope</th>
                                <th>Start Date (UTC)</th>
                                <th>End Date (UTC)</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in Model)
                            {
                                bool isMyOutbound = d.DelegatorUserId.ToString() == currentUserId;

                                <tr>
                                    <td>
                                        @if (isMyOutbound)
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-arrow-up-right me-1"></i> Delegated By Me</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-arrow-down-left me-1"></i> Delegated To Me</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">@d.DelegatorName</td>
                                    <td class="fw-semibold">@d.DelegateeName</td>
                                    <td>
                                        @if (d.RequestTypeId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">@d.RequestTypeName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">All Request Types</span>
                                        }
                                    </td>
                                    <td>@d.StartDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@d.EndDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (d.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Expired / Cancelled</span>
                                        }
                                    </td>
                                    <td class="small text-muted" style="max-width: 200px;">@d.Reason</td>
                                    <td class="text-end">
                                        @if (d.IsActive && isMyOutbound)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@d.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to cancel this delegation?');">
                                                    <i class="bi bi-x-circle me-1"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!-- Tab 2: Admin View -->
    @if (allDelegations != null)
    {
        <div class="tab-pane fade" id="admin-delegations" role="tabpanel">
            <div class="card card-custom">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Delegator</th>
                                <th>Delegatee</th>
                                <th>Scope</th>
                                <th>Start Date (UTC)</th>
                                <th>End Date (UTC)</th>
                                <th>Status</th>
                                <th>Reason</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in allDelegations.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @d.DelegatorName <br />
                                        <small class="text-muted font-monospace">@d.DelegatorEmail</small>
                                    </td>
                                    <td class="fw-semibold">
                                        @d.DelegateeName <br />
                                        <small class="text-muted font-monospace">@d.DelegateeEmail</small>
                                    </td>
                                    <td>
                                        @if (d.RequestTypeId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">@d.RequestTypeName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">All Request Types</span>
                                        }
                                    </td>
                                    <td>@d.StartDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@d.EndDateUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        @if (d.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="small text-muted" style="max-width: 200px;">@d.Reason</td>
                                    <td class="text-end">
                                        @if (d.IsActive)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@d.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this delegation?');">
                                                    <i class="bi bi-x-circle me-1"></i> Revoke
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
